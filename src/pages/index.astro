---
import Layout from '../layouts/Layout.astro';
import {
  KENNEL_INFO,
  BREEDER_HERITAGE_HIGHLIGHTS,
  BREEDER_BIO_NARRATION,
  DOGS,
  GALLERY_PHOTOS,
  MEMBER_UPDATES_LOG,
  SERVICE_DOG_HIGHLIGHTS,
  ASSISTANCE_DOG_COMPARISON,
  STUD_SERVICE_HIGHLIGHTS,
  LITTER_ROADMAP,
  BREED_GUIDE_CARDS,
  FAQS,
  SEO_LANDING_PAGES,
} from '../data/kennelData';
---

<Layout>
  <!-- Senior-Friendly Accessibility & Reading Comfort Toolbar -->
  <div class="a11y-toolbar" role="region" aria-label="Reading Comfort and Text Size Controls">
    <div class="container a11y-toolbar-inner">
      <span class="a11y-label">
        <span aria-hidden="true">👁</span> Reading Comfort &amp; Text Size:
      </span>
      <div class="a11y-controls">
        <button type="button" class="a11y-btn" data-set-text="normal" aria-pressed="true">
          A Standard
        </button>
        <button type="button" class="a11y-btn" data-set-text="large" aria-pressed="false">
          A+ Larger Text
        </button>
        <button type="button" class="a11y-btn" data-set-text="xlarge" aria-pressed="false">
          A++ Extra Large
        </button>
        <button type="button" class="a11y-btn" data-toggle-contrast aria-pressed="false">
          ◐ High Contrast
        </button>
      </div>
    </div>
  </div>

  <!-- Top Editorial Announcement Bar -->
  <div class="announcement-bar" role="region" aria-label="Kennel Announcements">
    <div class="container announcement-inner">
      <p class="announcement-text">
        <span class="badge-pill">SERVICE DOG &amp; PRESERVATION BREEDER</span>
        <strong>Dudley × Molly</strong> Planned Litters: <strong>Fall 2027 &amp; Spring 2028</strong> • Service Animal Inquiries: Contact Us ASAP
      </p>
      <div class="announcement-actions">
        <a
          href={KENNEL_INFO.gothamPawUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="announcement-link"
        >
          Gotham Paw Service Dogs ↗
        </a>
        <span aria-hidden="true">•</span>
        <a href={KENNEL_INFO.applicationPdfUrl} download="Qbits-SWD-Puppy-Application.pdf" class="announcement-link">
          ↓ Fillable PDF Application
        </a>
        <span aria-hidden="true">•</span>
        <a href={KENNEL_INFO.clinicalBrochurePdfUrl} download="Qbits-Clinical-Service-Dog-Brochure.pdf" class="announcement-link">
          ↓ Clinical Service Dog Brochure (PDF)
        </a>
        <span aria-hidden="true">•</span>
        <a href={`mailto:${KENNEL_INFO.email}`} class="announcement-link">{KENNEL_INFO.email}</a>
      </div>
    </div>
  </div>

  <!-- Sticky Navigation Header (Always visible & wraps cleanly on mobile, tablet & zoomed screens) -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="#" class="brand-logo" aria-label="Qbits Spanish Water Dog Kennel Home">
        <span class="brand-crest" aria-hidden="true">Q</span>
        <div class="brand-text">
          <span class="brand-title">Qbits Kennel</span>
          <span class="brand-sub">Upper East Side • NYC</span>
        </div>
      </a>

      <!-- MANDATORY per accessibility guidance: do not include the word "Navigation" in <nav aria-label> -->
      <nav class="primary-nav" aria-label="Primary">
        <a href="#service-animals" class="nav-highlight">Service &amp; Therapy Dogs</a>
        <a href="#pathway-quiz">60-Sec Pathway Quiz</a>
        <a href="#our-dogs">Dudley &amp; Molly</a>
        <a href="#member-updates">Gallery &amp; Updates</a>
        <a href="#stud-services">Stud Services</a>
        <a href="#upcoming-litters">2027/2028 Litters</a>
        <a href="#puppy-application">Puppy Application</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">Contact &amp; Call Back</a>
      </nav>

      <div class="header-cta-group">
        <button
          type="button"
          commandfor="puppy-app-dialog"
          command="show-modal"
          class="btn btn-primary btn-sm"
        >
          Quick Apply
        </button>
      </div>
    </div>
  </header>

  <!-- MANDATORY per accessibility guidance: tabindex="-1" on <main id="main-content"> for skip-link focus -->
  <main id="main-content" tabindex="-1">
    <!-- ====================================================================
         HERO SECTION (LCP Image optimized with fetchpriority="high")
         ==================================================================== -->
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Upper East Side, NYC • 1 of Only 5 SWD Breeders in America</span>
          <h1 id="hero-heading" class="hero-title">
            Qbits Spanish Water Dog Kennel
          </h1>
          <p class="hero-lead">
            One of <strong>only 5 active preservation Spanish Water Dog breeders in America</strong>, located on the Upper East Side of <strong>New York City</strong>. Mentored by breed pioneer <strong>Lisa Harper</strong> and led by America’s youngest SWD breeder (by 30 years) and professional service dog trainer, we raise health-tested dogs proven in <strong>neurological &amp; mobility service work</strong>, therapy visitation, and devoted family companionship.
          </p>

          <div class="hero-highlights" role="list" aria-label="Kennel Highlights">
            <div class="highlight-chip chip-service" role="listitem">
              <span class="chip-label">Service Animal Specialization</span>
              <strong>≥1 Puppy Per Litter Enters Our <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer">Gotham Paw</a> Service Program</strong>
            </div>
            <div class="highlight-chip" role="listitem">
              <span class="chip-label">Mentored by Pioneer Lisa Harper</span>
              <strong>1 of 5 US Breeders • Dudley (Stud) × Molly (Fall 2027 / Spring 2028)</strong>
            </div>
          </div>

          <div class="hero-actions">
            <a href="#service-animals" class="btn btn-primary">
              Service &amp; Therapy Dog Program
            </a>
            <a href="#puppy-application" class="btn btn-terracotta">
              Complete Puppy Application
            </a>
            <a
              href={KENNEL_INFO.applicationPdfUrl}
              download="Qbits-SWD-Puppy-Application.pdf"
              class="btn btn-outline"
            >
              ↓ Download Fillable PDF Form
            </a>
          </div>

          <p class="hero-note">
            <span>Direct Breeder &amp; Service Dog Inquiries:</span>
            <a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a>
            <span>•</span>
            <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer">
              Visit Gotham Paw Service Animal Training ↗
            </a>
          </p>
        </div>

        <div class="hero-media">
          <div class="hero-frame">
            <!-- MANDATORY per optimize-image-priority: fetchpriority="high" on LCP image, no loading="lazy" -->
            <img
              src={KENNEL_INFO.heroImage.src}
              alt={KENNEL_INFO.heroImage.alt}
              width={KENNEL_INFO.heroImage.width}
              height={KENNEL_INFO.heroImage.height}
              fetchpriority="high"
              class="hero-img"
            />
            <div class="hero-caption-card">
              <span class="caption-tag">UPPER EAST SIDE, NYC • PROVEN WORKING &amp; SERVICE LINES</span>
              <p>
                <strong>Dudley &amp; Molly</strong> — Raised underfoot in Manhattan with full OFA CHIC clearances and foundational training for medical assistance, therapy, and family life.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         TRUST & ETHICS BAR (SEO / AEO Key Facts)
         ==================================================================== -->
    <section class="ethics-strip" aria-label="Breeding Standards and Ethics">
      <div class="container ethics-grid">
        <div class="ethics-item">
          <span class="ethics-num">Service Proven</span>
          <p>At least 1 puppy per litter enters our <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-forest); font-weight: 700;">Gotham Paw</a> Service Dog Program for SCI &amp; neuromuscular conditions</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">OFA + CHIC</span>
          <p>Full hip, elbow, annual CAER eye &amp; DNA screening (prcd-PRA, NAD, CHG) on both parents</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">NYC Raised</span>
          <p>Whelped &amp; raised on the Upper East Side with Early Neurological Stimulation (ENS) &amp; urban exposure</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">2027 / 2028</span>
          <p>Accepting early applications for Dudley × Molly litters &amp; approved stud services with Dudley</p>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 01: ABOUT QBITS KENNEL (NYC) & OUR UNIQUE VALUE PROPOSITION
         ==================================================================== -->
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="container about-layout">
        <div class="about-header">
          <span class="eyebrow">01 • 1 of Only 5 Breeders in America • Upper East Side, NYC</span>
          <h2 id="about-heading" class="section-title">
            Historic Breed Mentorship Meets 21st-Century Service Dog Excellence
          </h2>
          <div class="breeder-uvp-box">
            <span class="uvp-tag">MENTORED BY BREED PIONEER LISA HARPER</span>
            <p>
              There are <strong>only 5 active Spanish Water Dog breeders in America</strong>, including Qbits Kennel. Although our founder is the <strong>youngest breeder in America by 30 years</strong>, we are every bit as serious and rigorous as the veteran breeders—guided directly by our mentor <strong>Lisa Harper</strong>, a lifelong national board member and foundational figure who was instrumental in legitimizing the Spanish Water Dog in the United States.
            </p>
          </div>
          <div class="breeder-uvp-box" style="margin-top: 1rem; border-left-color: var(--accent-forest);">
            <span class="uvp-tag" style="color: var(--accent-forest);">NATIONAL BREED CLUB BOARD &amp; DIGITAL LEADERSHIP</span>
            <p>
              Our founder has also helped grow and steward the Spanish Water Dog breed nationally by <strong>serving on the national breed club’s Board of Directors</strong> and <strong>modernizing the club’s website and digital infrastructure</strong> to bring the organization into the 21st century.
            </p>
          </div>

          <!-- Senior-Friendly Audio Read-Aloud Card -->
          <div class="audio-narration-card" role="region" aria-label="Audio Narration of Our Founder and Kennel Story">
            <span class="uvp-tag" style="color: var(--accent-forest);">🎧 SENIOR READING ACCESSIBILITY • LISTEN ALOUD</span>
            <p style="margin: 0.35rem 0 0.85rem; font-size: 0.95rem; color: var(--text-slate);">
              Prefer to listen rather than read? Click below to hear a clear spoken narration of our founder’s story, our mentorship under <strong>Lisa Harper</strong>, and our <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-forest); font-weight: 700;">Gotham Paw</a> service dog program.
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
              <button
                type="button"
                id="read-aloud-btn"
                class="btn btn-primary btn-sm"
                data-narration={BREEDER_BIO_NARRATION}
                aria-pressed="false"
              >
                🔊 Listen to Our Founder’s Story (Read Aloud)
              </button>
              <button
                type="button"
                id="stop-aloud-btn"
                class="btn btn-outline btn-sm"
                hidden
              >
                ⏹ Stop Audio
              </button>
            </div>
            <p id="read-aloud-status" class="sr-only" aria-live="polite"></p>
          </div>
        </div>
        <div class="about-content">
          <p class="lead-paragraph">
            At <strong>Qbits Spanish Water Dog Kennel</strong>, we believe the truest measure of a rare working breed is its ability to transform human lives. Based on the Upper East Side of New York City, our Spanish Water Dogs (<em>Perro de Agua Español</em>) experience a rich tapestry of urban sights, Central Park trails, NYC hospitals and transit, and weekend water work along the Northeast coast.
          </p>
          <p>
            <strong>Mentorship &amp; Stewardship at the Highest Level:</strong> Learning directly under <strong>Lisa Harper</strong>—whose decades of tireless work and lifelong board service helped legitimize and gain official recognition for the Spanish Water Dog in America—instilled in us an unshakeable reverence for authentic Iberian working type, genetic health, and ethical placement. Being the youngest of America’s five breeders by three decades allows us to pair that time-honored preservation wisdom with multi-decade future longevity for our puppy families.
          </p>
          <p>
            <strong>Why You Won’t See Us Every Weekend at AKC Conformation Shows:</strong> We are frequently asked why we do not campaign our dogs on the weekend AKC conformation show circuit. The answer goes to the heart of our mission: <strong>our dogs are proven as working service animals</strong>. Through our training company, <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent-forest); font-weight: 700;">Gotham Paw</a>, at least <strong>one puppy from every Qbits litter is transferred directly into our Service Animal Program</strong>, where we specialize in task-training service dogs for individuals with <strong>spinal cord injuries (SCI)</strong> and <strong>neuromuscular disorders</strong> such as <strong>Cerebral Palsy (CP) and Multiple Sclerosis (MS)</strong>.
          </p>
          <div class="about-pillars">
            {BREEDER_HERITAGE_HIGHLIGHTS.map((pillar) => (
              <div class="pillar-card">
                <span class="chip-label" style="display: block; margin-bottom: 0.25rem;">{pillar.badge}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 02: SERVICE ANIMALS, NEUROLOGICAL TASK TRAINING & THERAPY DOGS
         ==================================================================== -->
    <section id="service-animals" class="section section-forest" aria-labelledby="service-heading">
      <div class="container">
        <div class="section-header" style="max-width: 860px;">
          <span class="eyebrow" style="color: #F3B398;">02 • Service Animal Program &amp; Gotham Paw Partnership</span>
          <h2 id="service-heading" class="section-title">
            Task-Trained Service Animals for Spinal Cord Injuries &amp; Neuromuscular Disorders
          </h2>
          <p class="section-subtitle" style="color: var(--text-on-dark-muted);">
            At least <strong>one puppy from every Qbits litter</strong> is transferred into our specialized Service Animal Program in partnership with <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer" style="color: #FFFFFF; font-weight: 700; text-decoration: underline;">Gotham Paw Service Animal Training</a>. Many of our other puppies also go to homes where they serve as certified <strong>Therapy Dogs</strong>.
          </p>
        </div>

        <!-- Urgent Service Dog Callout Banner -->
        <div class="urgent-service-banner" role="region" aria-label="Urgent Notice for Prospective Service Dog Clients">
          <div class="urgent-service-copy">
            <span class="urgent-pill">IMPORTANT NOTICE • REACH OUT ASAP FOR SERVICE DOG PROSPECTS</span>
            <h3>Interested in a Task-Trained Service Animal? Please Contact Us Early</h3>
            <p>
              Producing, evaluating, matching, and custom task-training a medical service dog that meets our exacting neurological and public-access standards is an <strong>extraordinarily thorough, multi-stage process</strong>. If you or a loved one are living with a <strong>spinal cord injury (SCI), Cerebral Palsy, Multiple Sclerosis (MS), or another neuromuscular condition</strong> and wish to be considered for our Fall 2027 / Spring 2028 service candidates, please reach out to us <strong>as soon as possible</strong> so we can begin consultations well in advance.
            </p>
          </div>
          <div class="urgent-service-actions">
            <a
              href={KENNEL_INFO.gothamPawUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-terracotta"
            >
              Explore Gotham Paw Service Dog Program ↗
            </a>
            <a
              href={KENNEL_INFO.clinicalBrochurePdfUrl}
              download="Qbits-Clinical-Service-Dog-Brochure.pdf"
              class="btn btn-outline-light"
            >
              ↓ Download Clinical &amp; Family Brochure (PDF)
            </a>
            <a
              href="#contact"
              class="btn btn-outline-light"
              data-select-inquiry="URGENT: Service Animal Prospect Inquiry (Spinal Cord Injury / Neuromuscular — Gotham Paw)"
            >
              Inquire About a Service Dog ASAP
            </a>
          </div>
        </div>

        <!-- 4 Pillars of Our Service Dog Program -->
        <div class="service-pillars-grid">
          {SERVICE_DOG_HIGHLIGHTS.map((item) => (
            <article class="service-card">
              <span class="service-card-badge">{item.badge}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>

        <!-- Semantic Comparison Table: Service Dog vs. Therapy Dog vs. ESA (per accessibility guidance) -->
        <div class="comparison-wrapper">
          <div class="comparison-intro">
            <h3>Understanding the Difference: Task-Trained Service Dog vs. Therapy Dog vs. Emotional Support Animal (ESA)</h3>
            <p>
              Because confusion between assistance animal categories is common, we believe in educating every prospective client with crystal clarity. Under federal law, a <strong>task-trained service dog is legally a piece of medical equipment</strong>, whereas an <strong>Emotional Support Animal (ESA) only protects renters from being evicted or denied housing by a landlord that doesn’t allow pets</strong>.
            </p>
          </div>

          <div class="table-scroll-container" role="region" aria-labelledby="assistance-table-caption" tabindex="0">
            <table class="comparison-table">
              <caption id="assistance-table-caption" class="sr-only">
                Legal and functional comparison between a Task-Trained Service Dog, a Facility or Visitation Therapy Dog, and an Emotional Support Animal (ESA)
              </caption>
              <thead>
                <tr>
                  <th scope="col">Classification</th>
                  <th scope="col">Legal Status &amp; Definition</th>
                  <th scope="col">Required Training Standard</th>
                  <th scope="col">Public Access &amp; Housing Rights</th>
                  <th scope="col">How Qbits Kennel &amp; Gotham Paw Participate</th>
                </tr>
              </thead>
              <tbody>
                {ASSISTANCE_DOG_COMPARISON.map((row) => (
                  <tr>
                    <th scope="row" class="row-type-cell">
                      <strong>{row.type}</strong>
                    </th>
                    <td>{row.legalStatus}</td>
                    <td>{row.requiredTraining}</td>
                    <td>{row.publicAccessRights}</td>
                    <td>{row.qbitsRole}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         INTERACTIVE 60-SECOND "WHICH PLACEMENT PATHWAY FITS ME?" QUIZ
         (Senior-Accessible Self-Assessment Tool)
         ==================================================================== -->
    <section id="pathway-quiz" class="section" aria-labelledby="quiz-heading">
      <div class="container">
        <div class="quiz-shell">
          <div class="quiz-header">
            <span class="eyebrow">Interactive 60-Second Self-Assessment • Senior-Accessible</span>
            <h2 id="quiz-heading" class="section-title">
              Which Qbits Placement Pathway Fits Your Household?
            </h2>
            <p class="section-subtitle">
              Answer <strong>3 quick questions</strong> below to see whether you should apply for a <strong>Task-Trained Service Dog Prospect (via Gotham Paw)</strong>, a <strong>Certified Therapy Dog Prospect</strong>, or a <strong>Devoted Family &amp; Senior Companion</strong>—and pre-fill your application in one click.
            </p>
          </div>

          <form id="pathway-quiz-form" class="quiz-grid" aria-label="Placement Pathway Self-Assessment">
            <fieldset class="quiz-fieldset">
              <legend>1. What is the primary role you hope your Spanish Water Dog will fulfill?</legend>
              <div class="quiz-options">
                <label class="quiz-option-card">
                  <input type="radio" name="q1" value="service" required checked />
                  <span>
                    <strong>Physical or Neurological Medical Tasks for One Person</strong>
                    <small>Assisting with a spinal cord injury (SCI), Cerebral Palsy, Multiple Sclerosis (MS), dropped-item retrieval, door buttons, or mobility support.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q1" value="therapy" />
                  <span>
                    <strong>Visiting Hospitals, Rehab Centers, Schools, or Nursing Homes</strong>
                    <small>Bringing structured comfort and joy to many patients, students, or seniors in clinical or community facilities.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q1" value="companion" />
                  <span>
                    <strong>Loyal Daily Companionship, Walks, Travel &amp; Family Life</strong>
                    <small>A hypoallergenic, non-shedding, deeply bonded household companion for an active senior, couple, or family.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="quiz-fieldset">
              <legend>2. Where do you need legal access with your dog?</legend>
              <div class="quiz-options">
                <label class="quiz-option-card">
                  <input type="radio" name="q2" value="service" required checked />
                  <span>
                    <strong>Full ADA Public Access Everywhere (Medical Equipment Status)</strong>
                    <small>I have a disability and need my task-trained dog to accompany me into hospitals, restaurants, transit, and workplaces under the ADA.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q2" value="therapy" />
                  <span>
                    <strong>Invited Facility Visits (Hospitals, Schools, Libraries)</strong>
                    <small>I want to volunteer with my dog at registered facilities where therapy dog teams are invited.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q2" value="companion" />
                  <span>
                    <strong>Home, Parks, Dog-Friendly Patios &amp; Weekend Adventures</strong>
                    <small>Standard pet-friendly environments, Central Park walks, and family travel.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset class="quiz-fieldset">
              <legend>3. What level of professional training collaboration are you looking for?</legend>
              <div class="quiz-options">
                <label class="quiz-option-card">
                  <input type="radio" name="q3" value="service" required checked />
                  <span>
                    <strong>Professional Neurological &amp; Mobility Task Training via Gotham Paw</strong>
                    <small>Dedicated Volhard selection and professional service dog task training through Qbits Kennel &amp; Gotham Paw.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q3" value="therapy" />
                  <span>
                    <strong>CGC &amp; Therapy Dog Certification Preparation</strong>
                    <small>Early tactile socialization and guidance toward AKC Canine Good Citizen (CGC) and therapy registration.</small>
                  </span>
                </label>
                <label class="quiz-option-card">
                  <input type="radio" name="q3" value="companion" />
                  <span>
                    <strong>ENS Puppy Foundation + Lifetime Breeder Mentorship</strong>
                    <small>Well-socialized Manhattan-raised puppy with lifetime guidance on rustic coat care and positive family training.</small>
                  </span>
                </label>
              </div>
            </fieldset>

            <div class="quiz-actions-row">
              <button type="submit" class="btn btn-primary">
                ✓ See My Recommended Placement Pathway
              </button>
              <a
                href={KENNEL_INFO.clinicalBrochurePdfUrl}
                download="Qbits-Clinical-Service-Dog-Brochure.pdf"
                class="btn btn-outline"
              >
                ↓ Download Large-Print Clinical Brochure (PDF)
              </a>
            </div>
          </form>

          <!-- Quiz Result Recommendation Box -->
          <div id="quiz-result-box" class="quiz-result-box" role="status" aria-live="polite" hidden>
            <span id="quiz-result-badge" class="badge-pill" style="display: inline-block; margin-bottom: 0.5rem;">RECOMMENDED PATHWAY</span>
            <h3 id="quiz-result-title">Task-Trained Service Dog Prospect (via Gotham Paw)</h3>
            <p id="quiz-result-desc"></p>
            <div class="quiz-result-ctas">
              <a
                href="#puppy-application"
                id="quiz-apply-btn"
                class="btn btn-terracotta"
              >
                Pre-Fill My Application With This Pathway →
              </a>
              <a
                href={KENNEL_INFO.gothamPawUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline"
              >
                Explore Gotham Paw Service Dog Program ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         SECTION 03: MEET OUR DOGS: DUDLEY (STUD) & MOLLY (BITCH)
         ==================================================================== -->
    <section id="our-dogs" class="section section-sand" aria-labelledby="dogs-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">03 • Our Foundation Pair</span>
