<script>
  // 0. Senior Reading Comfort Toolbar (Text Size A / A+ / A++ & High Contrast)
  const textButtons = document.querySelectorAll<HTMLButtonElement>('[data-set-text]');
  const contrastBtn = document.querySelector<HTMLButtonElement>('[data-toggle-contrast]');

  function syncToolbarState() {
    const currentSize = document.documentElement.getAttribute('data-text-size') || 'normal';
    const isHighContrast = document.documentElement.getAttribute('data-contrast') === 'high';

    textButtons.forEach((btn) => {
      const btnSize = btn.getAttribute('data-set-text') || 'normal';
      btn.setAttribute('aria-pressed', btnSize === currentSize ? 'true' : 'false');
    });

    if (contrastBtn) {
      contrastBtn.setAttribute('aria-pressed', isHighContrast ? 'true' : 'false');
    }
  }

  syncToolbarState();

  textButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = btn.getAttribute('data-set-text') || 'normal';
      if (size === 'normal') {
        document.documentElement.removeAttribute('data-text-size');
      } else {
        document.documentElement.setAttribute('data-text-size', size);
      }
      try {
        localStorage.setItem('qbits-text-size', size);
      } catch {}
      syncToolbarState();
    });
  });

  if (contrastBtn) {
    contrastBtn.addEventListener('click', () => {
      const isHigh = document.documentElement.getAttribute('data-contrast') === 'high';
      if (isHigh) {
        document.documentElement.removeAttribute('data-contrast');
        try {
          localStorage.setItem('qbits-contrast', 'normal');
        } catch {}
      } else {
        document.documentElement.setAttribute('data-contrast', 'high');
        try {
          localStorage.setItem('qbits-contrast', 'high');
        } catch {}
      }
      syncToolbarState();
    });
  }

  // 1. MANDATORY per declarative-dialog-popover-control:
  // Feature detect 'commandForElement' on HTMLButtonElement.prototype and conditionally load polyfill
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    (async () => {
      try {
        // @ts-ignore - CDN fallback for older browsers without native Invoker Commands
        await import('https://esm.run/invokers-polyfill');
      } catch {
        // Fallback click delegation if offline or CDN blocked
      }
    })();

    document.addEventListener('click', (event) => {
      const targetEl = event.target as Element | null;
      const btn = targetEl?.closest('button[commandfor]') as HTMLButtonElement | null;
      if (!btn) return;
      const dialogId = btn.getAttribute('commandfor');
      const cmd = btn.getAttribute('command');
      const dialog = dialogId ? (document.getElementById(dialogId) as HTMLDialogElement | null) : null;
      if (!dialog) return;
      if (cmd === 'show-modal' && !dialog.open && typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else if (cmd === 'close' && dialog.open && typeof dialog.close === 'function') {
        dialog.close();
      }
    });
  }

  // 2. MANDATORY per validate-input-after-interaction:
  // Sync aria-invalid with CSS :user-invalid state & provide WeakMap fallback for older browsers
  const UserInvalidFallback = (() => {
    const dirtyState = new WeakMap<Element, { hasInteracted: boolean; hasBlurred: boolean }>();

    const updateState = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const isValid = input.checkValidity();
      input.classList.toggle('user-invalid-fallback', !isValid);
      input.classList.toggle('user-valid-fallback', isValid);
      if (!isValid) {
        input.setAttribute('aria-invalid', 'true');
      } else {
        input.removeAttribute('aria-invalid');
      }
    };

    const handleEvent = (event: Event) => {
      const input = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      if (!input || typeof input.checkValidity !== 'function') return;

      if (event.type === 'input' || event.type === 'change') {
        const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
        state.hasInteracted = true;
        dirtyState.set(input, state);
        if (state.hasBlurred) updateState(input);
      } else if (event.type === 'blur') {
        const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
        state.hasBlurred = true;
        dirtyState.set(input, state);
        if (state.hasInteracted) updateState(input);
      }
    };

    const init = (root: Document | Element = document) => {
      if (CSS.supports('selector(:user-invalid)')) return;
      root.addEventListener('blur', handleEvent, true);
      root.addEventListener('input', handleEvent);
      root.addEventListener('change', handleEvent);
    };

    return { init };
  })();

  UserInvalidFallback.init(document);

  const syncAria = (el: EventTarget | null) => {
    if (!(el instanceof HTMLElement)) return;
    if ('checkValidity' in el) {
      try {
        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
      } catch {
        // Handled by UserInvalidFallback
      }
    }
  };

  document.addEventListener('blur', (e) => syncAria(e.target), true);
  document.addEventListener('input', (e) => {
    if (e.target instanceof HTMLElement && e.target.hasAttribute('aria-invalid')) {
      syncAria(e.target);
    }
  });

  // 3. Pre-select Inquiry Topic when clicking "Inquire About Dudley's Stud Service" or "Inquire About a Service Dog ASAP"
  document.querySelectorAll('[data-select-inquiry]').forEach((link) => {
    link.addEventListener('click', () => {
      const desired = link.getAttribute('data-select-inquiry');
      const topicSelect = document.getElementById('contact-topic') as HTMLSelectElement | null;
      if (topicSelect && desired) {
        topicSelect.value = desired;
      }
    });
  });

  // 4. Helper to format Puppy Application Form into mailto:dog@cmejo.com + Netlify Forms submission
  function buildApplicationPayload(form: HTMLFormElement) {
    const data = new FormData(form);
    const name = (data.get('applicantName') || '').toString().trim();
    const coName = (data.get('coApplicantName') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const phone = (data.get('phone') || '').toString().trim();
    const location = (data.get('location') || '').toString().trim();
    const housingType = (data.get('housingType') || 'Not specified').toString().trim();
    const ownership = (data.get('ownership') || 'Not specified').toString().trim();
    const hoursAlone = (data.get('hoursAlone') || 'Not specified').toString().trim();
    const exercisePlan = (data.get('exercisePlan') || 'See notes below').toString().trim();
    const litterTiming = (data.get('litterTiming') || '').toString().trim();
    const sexPreference = (data.get('sexPreference') || 'Open').toString().trim();
    const primaryGoals = (data.get('primaryGoals') || 'Companion').toString().trim();
    const breedExperience = (data.get('breedExperience') || '').toString().trim();

    const subject = `Qbits SWD Application [${primaryGoals}] (${litterTiming}) - ${name}`;
    const body = [
      'QBITS SPANISH WATER DOG KENNEL (NYC) — APPLICATION',
      '==================================================',
      `Primary Applicant: ${name}`,
      coName ? `Co-Applicant / Caregiver: ${coName}` : null,
      `Email: ${email}`,
      `Phone: ${phone}`,
      `Location: ${location}`,
      '',
      'LIVING ENVIRONMENT & ROUTINE',
      '----------------------------',
      `Residence Type: ${housingType}`,
      `Ownership: ${ownership}`,
      `Hours Alone Daily: ${hoursAlone}`,
      `Exercise & Outdoor Plan: ${exercisePlan}`,
      '',
      'PLACEMENT PATHWAY & LITTER PREFERENCES',
      '--------------------------------------',
      `Primary Pathway: ${primaryGoals}`,
      `Preferred Window: ${litterTiming}`,
      `Sex Preference: ${sexPreference}`,
      '',
      'SERVICE NEEDS, EXPERIENCE & NOTES',
      '---------------------------------',
      breedExperience,
    ]
      .filter((line) => line !== null)
      .join('\n');

    return { subject, body, data };
  }

  function attachApplicationHandler(formId: string, statusId?: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const { subject, body, data } = buildApplicationPayload(form);
      const mailtoUrl = `mailto:dog@cmejo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      // Track conversion in GA4, Piwik PRO & dataLayer
      if (typeof (window as any).qbitsTrackEvent === 'function') {
        (window as any).qbitsTrackEvent('generate_lead_puppy_application', {
          category: 'Application Funnel',
          label: (data.get('primaryGoals') || 'Puppy Application').toString(),
        });
      }

      // Submit to Netlify Forms in the background so senior users on webmail don't lose their submission
      try {
        const urlEncoded = new URLSearchParams();
        data.forEach((val, key) => urlEncoded.append(key, val.toString()));
        if (!urlEncoded.has('form-name')) {
          urlEncoded.append('form-name', 'qbits-puppy-application');
        }
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: urlEncoded.toString(),
        });
      } catch {
        // Fallback to mailto below
      }

      window.location.href = mailtoUrl;

      if (statusId) {
        const statusEl = document.getElementById(statusId);
        if (statusEl) {
          statusEl.hidden = false;
          statusEl.innerHTML =
            '✓ Thank you! Your application has been recorded and your email client is opening addressed to <a href="mailto:dog@cmejo.com" style="color: var(--accent-forest); font-weight: 700;">dog@cmejo.com</a>.';
        }
      }
    });
  }

  attachApplicationHandler('inline-puppy-app-form', 'inline-app-status');
  attachApplicationHandler('modal-puppy-app-form', 'modal-app-status');

  // 5. Contact & Service/Stud Inquiry Form Handler
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactStatus = document.getElementById('contact-status');

  function buildContactPayload(form: HTMLFormElement) {
    const data = new FormData(form);
    const topic = (data.get('topic') || 'Kennel Inquiry').toString().trim();
    const name = (data.get('name') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const phone = (data.get('phone') || 'Not provided').toString().trim();
    const city = (data.get('city') || '').toString().trim();
    const message = (data.get('message') || '').toString().trim();

    const subject = `[Qbits SWD Kennel NYC] ${topic} — ${name}`;
    const body = [
      `Inquiry Topic: ${topic}`,
      `Name: ${name}`,
      `Email: ${email}`,
      `Phone: ${phone}`,
      `City/State: ${city}`,
      '',
      'Message:',
      message,
    ].join('\n');

    return { subject, body, data };
  }

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }
      const { subject, body, data } = buildContactPayload(contactForm);

      if (typeof (window as any).qbitsTrackEvent === 'function') {
        (window as any).qbitsTrackEvent('generate_lead_contact_inquiry', {
          category: 'Contact Funnel',
          label: (data.get('topic') || 'General Inquiry').toString(),
        });
      }

      try {
        const urlEncoded = new URLSearchParams();
        data.forEach((val, key) => urlEncoded.append(key, val.toString()));
        if (!urlEncoded.has('form-name')) {
          urlEncoded.append('form-name', 'qbits-contact-inquiry');
        }
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: urlEncoded.toString(),
        });
      } catch {
        // Fallback to mailto below
      }

      window.location.href = `mailto:dog@cmejo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (contactStatus) {
        contactStatus.hidden = false;
        contactStatus.innerHTML =
          '✓ Thank you! Your inquiry has been recorded and your default mail app is opening addressed to <a href="mailto:dog@cmejo.com" style="color: var(--accent-forest); font-weight: 700;">dog@cmejo.com</a>.';
      }
    });
  }

  // 6. Senior-Friendly Audio Read-Aloud Narration (Web Speech API)
  const readAloudBtn = document.getElementById('read-aloud-btn') as HTMLButtonElement | null;
  const stopAloudBtn = document.getElementById('stop-aloud-btn') as HTMLButtonElement | null;
  const readAloudStatus = document.getElementById('read-aloud-status');

  if (readAloudBtn && 'speechSynthesis' in window) {
    readAloudBtn.addEventListener('click', () => {
      const narrationText = readAloudBtn.getAttribute('data-narration') || '';
      if (!narrationText) return;

      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        readAloudBtn.setAttribute('aria-pressed', 'false');
        readAloudBtn.textContent = '🔊 Listen to Our Founder’s Story (Read Aloud)';
        if (stopAloudBtn) stopAloudBtn.hidden = true;
        if (readAloudStatus) readAloudStatus.textContent = 'Audio narration stopped.';
        return;
      }

      const utterance = new SpeechSynthesisUtterance(narrationText);
      utterance.rate = 0.94; // Slightly calmer cadence for senior listening comfort
      utterance.pitch = 1.0;

      utterance.onstart = () => {
        readAloudBtn.setAttribute('aria-pressed', 'true');
        readAloudBtn.textContent = '🔊 Playing Founder’s Story... (Click to Restart/Stop)';
        if (stopAloudBtn) stopAloudBtn.hidden = false;
        if (readAloudStatus) readAloudStatus.textContent = 'Playing audio narration of Qbits Spanish Water Dog Kennel founder story.';
      };

      utterance.onend = () => {
        readAloudBtn.setAttribute('aria-pressed', 'false');
        readAloudBtn.textContent = '🔊 Listen to Our Founder’s Story (Read Aloud)';
        if (stopAloudBtn) stopAloudBtn.hidden = true;
        if (readAloudStatus) readAloudStatus.textContent = 'Audio narration completed.';
      };

      utterance.onerror = () => {
        readAloudBtn.setAttribute('aria-pressed', 'false');
        readAloudBtn.textContent = '🔊 Listen to Our Founder’s Story (Read Aloud)';
        if (stopAloudBtn) stopAloudBtn.hidden = true;
      };

      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);

      if (typeof (window as any).qbitsTrackEvent === 'function') {
        (window as any).qbitsTrackEvent('play_founder_audio_narration', {
          category: 'Accessibility Engagement',
          label: 'Founder Bio Read Aloud',
        });
      }
    });

    if (stopAloudBtn) {
      stopAloudBtn.addEventListener('click', () => {
        window.speechSynthesis.cancel();
        readAloudBtn.setAttribute('aria-pressed', 'false');
        readAloudBtn.textContent = '🔊 Listen to Our Founder’s Story (Read Aloud)';
        stopAloudBtn.hidden = true;
        if (readAloudStatus) readAloudStatus.textContent = 'Audio narration stopped.';
      });
    }
  } else if (readAloudBtn) {
    readAloudBtn.hidden = true;
  }

  // 7. Interactive 60-Second Placement Pathway Self-Assessment Quiz
  const quizForm = document.getElementById('pathway-quiz-form') as HTMLFormElement | null;
  const quizResultBox = document.getElementById('quiz-result-box');
  const quizResultTitle = document.getElementById('quiz-result-title');
  const quizResultDesc = document.getElementById('quiz-result-desc');
  const quizApplyBtn = document.getElementById('quiz-apply-btn') as HTMLAnchorElement | null;

  if (quizForm && quizResultBox && quizResultTitle && quizResultDesc) {
    quizForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(quizForm);
      const answers = [data.get('q1'), data.get('q2'), data.get('q3')];
      const counts: Record<string, number> = { service: 0, therapy: 0, companion: 0 };
      answers.forEach((ans) => {
        if (typeof ans === 'string' && ans in counts) {
          counts[ans] += 1;
        }
      });

      let chosen: 'service' | 'therapy' | 'companion' = 'companion';
      if (counts.service >= counts.therapy && counts.service >= counts.companion) {
        chosen = 'service';
      } else if (counts.therapy >= counts.companion) {
        chosen = 'therapy';
      }

      const pathwayMap = {
        service: {
          title: 'Recommended Pathway: Task-Trained Service Dog Prospect (via Gotham Paw)',
          desc: 'Based on your answers, you are seeking an individually task-trained medical service dog with full ADA public-access rights for a spinal cord injury (SCI), Cerebral Palsy, Multiple Sclerosis (MS), or neuromuscular disability. Because our service dog matching and training process is extraordinarily thorough, we recommend reaching out to us and Gotham Paw as early as possible.',
          selectValue: 'Task-Trained Service Dog Prospect (SCI / Neuromuscular via Gotham Paw)',
        },
        therapy: {
          title: 'Recommended Pathway: Certified Therapy Dog Prospect (Hospital / Rehab / School Visitation)',
          desc: 'Based on your answers, a Qbits Spanish Water Dog selected for calm tactile tolerance and people-focused biddability is an ideal match for hospital, rehabilitation center, nursing home, or school therapy visitation.',
          selectValue: 'Certified Therapy Dog Prospect (Hospital / Rehab / School Visitation)',
        },
        companion: {
          title: 'Recommended Pathway: Devoted Family & Senior Companion (Fall 2027 / Spring 2028)',
          desc: 'Based on your answers, you are looking for a health-tested, non-shedding, Manhattan-socialized Spanish Water Dog puppy raised underfoot with Early Neurological Stimulation (ENS) and lifetime breeder mentorship.',
          selectValue: 'Active Family / Senior Companion',
        },
      };

      const result = pathwayMap[chosen];
      quizResultTitle.textContent = result.title;
      quizResultDesc.textContent = result.desc;
      quizResultBox.hidden = false;

      // Pre-select the pathway in both the inline application form and modal application form
      const appGoalsSelect = document.getElementById('app-goals') as HTMLSelectElement | null;
      if (appGoalsSelect) {
        appGoalsSelect.value = result.selectValue;
      }

      if (quizApplyBtn) {
        quizApplyBtn.onclick = () => {
          if (appGoalsSelect) {
            appGoalsSelect.value = result.selectValue;
          }
        };
      }

      if (typeof (window as any).qbitsTrackEvent === 'function') {
        (window as any).qbitsTrackEvent('complete_pathway_quiz', {
          category: 'Conversion Tool',
          label: result.selectValue,
        });
      }
    });
  }

  // 8. 2-Field Senior-Friendly Phone Call Back Micro-Form Handler
  const callbackForm = document.getElementById('callback-form') as HTMLFormElement | null;
  const callbackStatus = document.getElementById('callback-status');

  if (callbackForm) {
    callbackForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!callbackForm.checkValidity()) {
        callbackForm.reportValidity();
        return;
      }
      const data = new FormData(callbackForm);
      const callerName = (data.get('callerName') || '').toString().trim();
      const callerPhone = (data.get('callerPhone') || '').toString().trim();

      if (typeof (window as any).qbitsTrackEvent === 'function') {
        (window as any).qbitsTrackEvent('request_phone_callback', {
          category: 'Senior Call Back Funnel',
          label: callerName,
        });
      }

      try {
        const urlEncoded = new URLSearchParams();
        urlEncoded.append('form-name', 'qbits-callback-request');
        urlEncoded.append('callerName', callerName);
        urlEncoded.append('callerPhone', callerPhone);
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: urlEncoded.toString(),
        });
      } catch {
        // Fallback to mailto below
      }

      const subject = `[Qbits SWD Kennel NYC] 10-Minute Phone Call Back Request — ${callerName}`;
      const body = `Phone Call Back Request:\nName: ${callerName}\nPhone & Best Time: ${callerPhone}\n\nPlease call me back regarding Qbits Spanish Water Dog Kennel / Gotham Paw Service Dogs.`;
      window.location.href = `mailto:dog@cmejo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (callbackStatus) {
        callbackStatus.hidden = false;
        callbackStatus.innerHTML =
          '✓ Thank you! Your 10-minute phone call back request has been sent and your mail app is opening addressed to <a href="mailto:dog@cmejo.com" style="color: var(--accent-forest); font-weight: 700;">dog@cmejo.com</a>.';
      }
    });
  }
</script>
