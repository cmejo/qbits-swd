                  name="exercisePlan"
                  required
                  aria-describedby="app-exercise-hint"
                  aria-errormessage="app-exercise-error"
                ></textarea>
                <div id="app-exercise-error" class="error-msg">
                  <span aria-hidden="true">⚠</span> Please describe your outdoor access and exercise plan.
                </div>
              </div>
            </fieldset>

            <fieldset class="form-fieldset">
              <legend>3. Service Dog, Therapy Dog or Companion Goals (Dudley × Molly)</legend>
              <div class="form-row-3">
                <div class="field">
                  <label for="app-goals">Primary Placement Pathway *</label>
                  <span id="app-goals-hint" class="hint">Select Service Dog, Therapy Dog, or Companion</span>
                  <select id="app-goals" name="primaryGoals" required aria-describedby="app-goals-hint">
                    <option value="Task-Trained Service Dog Prospect (SCI / Neuromuscular via Gotham Paw)">
                      Task-Trained Service Dog Prospect (SCI / Neuromuscular via Gotham Paw)
                    </option>
                    <option value="Certified Therapy Dog Prospect (Hospital / Rehab / School Visitation)">
                      Certified Therapy Dog Prospect (Hospital / Rehab / School Visitation)
                    </option>
                    <option value="Active Family / Senior Companion">
                      Devoted Family / Senior Companion
                    </option>
                    <option value="Performance / Agility / Scent / Water Work">
                      Performance / Agility / Scent / Water Work
                    </option>
                  </select>
                </div>

                <div class="field">
                  <label for="app-timing">Preferred Litter Timing *</label>
                  <span id="app-timing-hint" class="hint">Planned windows for Dudley × Molly</span>
                  <select id="app-timing" name="litterTiming" required aria-describedby="app-timing-hint">
                    <option value="Either Fall 2027 or Spring 2028">Either Fall 2027 or Spring 2028 (First Match)</option>
                    <option value="Fall 2027 Preferred">Fall 2027 Litter Preferred</option>
                    <option value="Spring 2028 Preferred">Spring 2028 Litter Preferred</option>
                  </select>
                </div>

                <div class="field">
                  <label for="app-sex">Sex Preference *</label>
                  <span id="app-sex-hint" class="hint">We match primarily on temperament &amp; task aptitude</span>
                  <select id="app-sex" name="sexPreference" required aria-describedby="app-sex-hint">
                    <option value="Open / Best Temperament & Task Match">No Preference (Best Temperament / Task Fit)</option>
                    <option value="Male Preferred">Male Preferred</option>
                    <option value="Female Preferred">Female Preferred</option>
                  </select>
                </div>
              </div>

              <div class="field">
                <label for="app-experience">Service Task Needs, Therapy Goals, or Dog Experience *</label>
                <span id="app-experience-hint" class="hint">If applying for a Service Animal, please share any neurological/mobility tasks needed (e.g., item retrieval, counterbalance, door buttons). Also share past dog experience and familiarity with rustic coat care (never brushed).</span>
                <textarea
                  id="app-experience"
                  name="breedExperience"
                  required
                  aria-describedby="app-experience-hint"
                  aria-errormessage="app-experience-error"
                ></textarea>
                <div id="app-experience-error" class="error-msg">
                  <span aria-hidden="true">⚠</span> Please share your goals, service needs (if applicable), and dog experience.
                </div>
              </div>
            </fieldset>

            <div class="form-submit-bar">
              <button type="submit" class="btn btn-primary">
