  }

  .hero-title {
    font-size: clamp(2.65rem, 5.2vw, 4.35rem);
    font-weight: 600;
    margin-bottom: 1.15rem;
    line-height: 1.06;
  }

  .hero-lead {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--text-slate);
    margin-bottom: 1.5rem;
    max-width: 62ch;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .highlight-chip {
    background-color: var(--bg-sand);
    border: 1px solid var(--border-stone);
    border-left: 4px solid var(--accent-forest);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.92rem;
  }

  .chip-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-note a {
    color: var(--accent-forest);
    font-weight: 700;
  }

  .inline-copy-btn {
    background: var(--bg-sand);
    border: 1px solid var(--border-strong);
    color: var(--text-espresso);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    min-height: 32px;
  }

  .inline-copy-btn:hover {
    background: var(--border-stone);
  }

  .hero-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1px solid var(--border-stone);
    background-color: var(--bg-sand);
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero-caption-card {
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border-top: 1px solid var(--border-stone);
    font-size: 0.85rem;
    color: var(--text-slate);
  }

  .hero-caption-card p {
    margin: 0.25rem 0 0;
  }

  .caption-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent-terracotta);
    letter-spacing: 0.08em;
  }

  /* Ethics Strip */
  .ethics-strip {
    background-color: var(--bg-sand);
    border-block: 1px solid var(--border-stone);
    padding-block: 2rem;
  }

  .ethics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .ethics-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ethics-num {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--accent-forest);
  }

  .ethics-item p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-slate);
  }

  /* About Section */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .about-layout {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
    }
  }

  .lead-paragraph {
    font-size: 1.15rem;
    color: var(--text-espresso);
    margin-top: 0;
  }

  .about-pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-soft);
  }

  .pillar-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
    color: var(--accent-forest);
  }

  .pillar-card p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-slate);
  }

  /* Dogs Section */
  .dogs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 980px) {
    .dogs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dog-card {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
  }

  .dog-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-sand);
  }

  .dog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dog-role-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(22, 48, 38, 0.92);
    color: var(--text-on-dark);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  .dog-body {
    padding: clamp(1.5rem, 3vw, 2.15rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dog-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dog-sex-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .dog-callname {
    font-size: 2.35rem;
    margin: 0.1rem 0 0.25rem;
  }

  .dog-dob {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: var(--bg-sand);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    color: var(--text-slate);
  }

  .dog-reg-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--text-slate);
    margin: 0 0 0.25rem;
  }

  .dog-pedigree {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .dog-titles-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .title-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    background: var(--bg-alabaster);
    border: 1px solid var(--border-stone);
    color: var(--accent-forest);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .dog-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    background: var(--bg-alabaster);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin: 0 0 1.15rem;
  }

  .dog-specs dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .dog-specs dd {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-espresso);
  }

  .dog-summary,
  .dog-temperament {
    font-size: 0.95rem;
    color: var(--text-slate);
    margin: 0 0 0.9rem;
  }

  .clearances-box {
    background: var(--bg-alabaster);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    margin-top: auto;
    margin-bottom: 1.4rem;
  }

  .clearances-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .chic-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--valid-green);
    background: var(--valid-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .clearances-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
  }

  .clearance-item {
    background: #FFFFFF;
    border: 1px solid var(--border-stone);
    border-radius: 6px;
    padding: 0.45rem 0.65rem;
    display: flex;
    flex-direction: column;
  }

  .clearance-test {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .clearance-result {
    font-size: 0.84rem;
    color: var(--accent-forest);
  }

  .clearance-code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  /* Stud Section */
  .stud-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .stud-layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .stud-lead {
    font-size: 1.08rem;
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
  }

  .stud-cta-box {
    background: var(--bg-forest-elevated);
    border: 1px solid rgba(250, 247, 242, 0.2);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .stud-cta-box h3 {
    font-size: 1.45rem;
    margin-bottom: 0.5rem;
  }

  .stud-cta-box p {
    color: var(--text-on-dark-muted);
    font-size: 0.94rem;
    margin-bottom: 1.25rem;
  }

  .stud-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stud-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .stud-feature-card {
    background: var(--bg-forest-elevated);
    border: 1px solid rgba(250, 247, 242, 0.16);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem;
  }

  .stud-feature-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #E8A588;
    font-weight: 600;
  }

  .stud-feature-card h3 {
    font-size: 1.3rem;
    margin: 0.25rem 0 0.4rem;
  }

  .stud-feature-card p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text-on-dark-muted);
  }

  /* Litters & Pairing */
  .pairing-banner {
    background: var(--bg-sand);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .pairing-banner {
      grid-template-columns: 1fr auto 1fr 1.3fr;
    }
  }

  .pairing-parent {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .pairing-role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .pairing-parent h3 {
    font-size: 1.85rem;
    margin: 0.15rem 0 0.35rem;
  }

  .pairing-parent p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-slate);
  }

  .pairing-cross {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--accent-terracotta);
    text-align: center;
    font-weight: 700;
  }

  .pairing-window-badge {
    display: inline-block;
    background: var(--accent-forest);
    color: var(--text-on-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .pairing-summary h4 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .pairing-summary p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-slate);
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .roadmap-card {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-top: 4px solid var(--accent-forest);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    box-shadow: var(--shadow-soft);
  }

  .roadmap-phase {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .roadmap-card h3 {
    font-size: 1.3rem;
    margin: 0.35rem 0 0.5rem;
  }

  .roadmap-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-slate);
  }

  /* Breed Guide */
  .breed-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .breed-card {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .breed-card-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .breed-card-body {
    padding: 1.4rem;
  }

  .breed-category {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--accent-terracotta);
    font-weight: 600;
  }

  .breed-card-body h3 {
    font-size: 1.4rem;
    margin: 0.25rem 0 0.5rem;
  }

  .breed-card-body p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text-slate);
  }

  .breed-specs-bar {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .breed-specs-bar span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .breed-specs-bar strong {
    font-size: 0.95rem;
    color: var(--accent-forest);
  }

  /* Puppy Application Section */
  .pdf-download-banner {
    background: linear-gradient(135deg, #FAF7F2 0%, #F1EBE1 100%);
    border: 2px solid var(--accent-terracotta);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-soft);
  }

  .pdf-banner-info {
    max-width: 680px;
  }

  .pdf-badge {
    display: inline-block;
    background: var(--accent-terracotta);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }

  .pdf-banner-info h3 {
    font-size: 1.65rem;
    margin-bottom: 0.4rem;
  }

  .pdf-banner-info p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-slate);
  }

  .pdf-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .application-card {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-soft);
  }

  .application-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-stone);
  }

  .application-card-header h3 {
    font-size: 1.75rem;
    margin-bottom: 0.35rem;
  }

  .application-card-header p {
    margin: 0;
    color: var(--text-slate);
    font-size: 0.95rem;
  }

  .form-fieldset {
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin: 0 0 1.5rem;
    background: var(--bg-alabaster);
  }

  .form-fieldset legend {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent-forest);
    padding-inline: 0.5rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .form-row-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
    .form-row-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .form-submit-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
  }

  .form-status-banner {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--valid-bg);
    border: 1px solid var(--valid-green);
    color: var(--text-espresso);
    font-size: 0.92rem;
  }

  /* FAQ Layout */
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 920px) {
    .faq-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3.5rem;
    }
  }

  /* Contact Section */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 920px) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
    }
  }

  .contact-direct-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .direct-card {
    background: var(--bg-sand);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .direct-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .direct-value {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--accent-forest);
    text-decoration: none;
  }

  .contact-form-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: var(--shadow-soft);
  }

  .contact-form-panel h3 {
    font-size: 1.75rem;
    margin-bottom: 0.35rem;
  }

  .form-panel-sub {
    font-size: 0.93rem;
    color: var(--text-slate);
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  .contact-submit-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .modal-pdf-callout {
    background: var(--bg-sand);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  /* Footer */
  .site-footer {
    background-color: var(--bg-forest);
    color: var(--text-on-dark);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(250, 247, 242, 0.14);
  }

  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  .footer-desc {
    color: var(--text-on-dark-muted);
    font-size: 0.93rem;
    max-width: 46ch;
  }

  .footer-email a {
    color: #E8A588;
    font-weight: 700;
  }

  .footer-links h3 {
    color: var(--text-on-dark);
    font-size: 1.2rem;
    margin-bottom: 0.85rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links a {
    color: var(--text-on-dark-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .footer-links a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.84rem;
    color: var(--text-on-dark-muted);
  }

  .footer-bottom p {
    margin: 0;
  }
</style>

<script>
  // 1. MANDATORY per declarative-dialog-popover-control:
  // Feature detect 'commandForElement' on HTMLButtonElement.prototype and conditionally load polyfill
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    (async () => {
      try {
        // @ts-ignore - CDN fallback for older browsers without native Invoker Commands
        await import('https://esm.run/invokers-polyfill');
      } catch {
        // Fallback click delegation if offline or CDN blocked
      }
    })();

    document.addEventListener('click', (event) => {
      const targetEl = event.target as Element | null;
      const btn = targetEl?.closest('button[commandfor]') as HTMLButtonElement | null;
      if (!btn) return;
      const dialogId = btn.getAttribute('commandfor');
      const cmd = btn.getAttribute('command');
      const dialog = dialogId ? (document.getElementById(dialogId) as HTMLDialogElement | null) : null;
      if (!dialog) return;
      if (cmd === 'show-modal' && !dialog.open && typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else if (cmd === 'close' && dialog.open && typeof dialog.close === 'function') {
        dialog.close();
      }
    });
  }

  // 2. MANDATORY per validate-input-after-interaction:
  // Sync aria-invalid with CSS :user-invalid state & provide WeakMap fallback for older browsers
  const UserInvalidFallback = (() => {
    const dirtyState = new WeakMap<Element, { hasInteracted: boolean; hasBlurred: boolean }>();

    const updateState = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const isValid = input.checkValidity();
      input.classList.toggle('user-invalid-fallback', !isValid);
      input.classList.toggle('user-valid-fallback', isValid);
      if (!isValid) {
        input.setAttribute('aria-invalid', 'true');
      } else {
        input.removeAttribute('aria-invalid');
      }
    };

    const handleEvent = (event: Event) => {
      const input = event.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      if (!input || typeof input.checkValidity !== 'function') return;

      if (event.type === 'input' || event.type === 'change') {
        const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
        state.hasInteracted = true;
        dirtyState.set(input, state);
        if (state.hasBlurred) updateState(input);
      } else if (event.type === 'blur') {
        const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
        state.hasBlurred = true;
        dirtyState.set(input, state);
        if (state.hasInteracted) updateState(input);
      }
    };

    const init = (root: Document | Element = document) => {
      if (CSS.supports('selector(:user-invalid)')) return;
      root.addEventListener('blur', handleEvent, true);
      root.addEventListener('input', handleEvent);
      root.addEventListener('change', handleEvent);
    };

    return { init };
  })();

  UserInvalidFallback.init(document);

  const syncAria = (el: EventTarget | null) => {
    if (!(el instanceof HTMLElement)) return;
    if ('checkValidity' in el) {
      try {
        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
      } catch {
        // Handled by UserInvalidFallback
      }
    }
  };

  document.addEventListener('blur', (e) => syncAria(e.target), true);
  document.addEventListener('input', (e) => {
    if (e.target instanceof HTMLElement && e.target.hasAttribute('aria-invalid')) {
      syncAria(e.target);
    }
  });

  // 3. Copy-Email buttons
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-copy-email') || 'dog@cmejo.com';
      const originalText = btn.textContent;
      try {
        await navigator.clipboard.writeText(email);
        btn.textContent = `✓ Copied ${email}`;
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2500);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  });

  // 4. Pre-select Inquiry Topic when clicking "Inquire About Dudley's Stud Service"
  document.querySelectorAll('[data-select-inquiry]').forEach((link) => {
    link.addEventListener('click', () => {
      const desired = link.getAttribute('data-select-inquiry');
      const topicSelect = document.getElementById('contact-topic') as HTMLSelectElement | null;
      if (topicSelect && desired) {
        topicSelect.value = desired;
      }
    });
  });

  // 5. Helper to format Puppy Application Form into mailto:dog@cmejo.com or Clipboard
  function buildApplicationPayload(form: HTMLFormElement) {
    const data = new FormData(form);
    const name = (data.get('applicantName') || '').toString().trim();
    const coName = (data.get('coApplicantName') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const phone = (data.get('phone') || '').toString().trim();
    const location = (data.get('location') || '').toString().trim();
    const housingType = (data.get('housingType') || 'Not specified').toString().trim();
    const ownership = (data.get('ownership') || 'Not specified').toString().trim();
    const hoursAlone = (data.get('hoursAlone') || 'Not specified').toString().trim();
    const exercisePlan = (data.get('exercisePlan') || 'See notes below').toString().trim();
    const litterTiming = (data.get('litterTiming') || '').toString().trim();
    const sexPreference = (data.get('sexPreference') || '').toString().trim();
    const primaryGoals = (data.get('primaryGoals') || 'Companion').toString().trim();
    const breedExperience = (data.get('breedExperience') || '').toString().trim();

    const subject = `Qbits SWD Puppy Application (${litterTiming}) - ${name}`;
    const body = [
      'QBITS SPANISH WATER DOG KENNEL (NYC) — PUPPY APPLICATION',
      '========================================================',
      `Primary Applicant: ${name}`,
      coName ? `Co-Applicant: ${coName}` : null,
      `Email: ${email}`,
      `Phone: ${phone}`,
      `Location: ${location}`,
      '',
      'LIVING ENVIRONMENT & ROUTINE',
      '----------------------------',
      `Residence Type: ${housingType}`,
      `Ownership: ${ownership}`,
      `Hours Alone Daily: ${hoursAlone}`,
      `Exercise & Outdoor Plan: ${exercisePlan}`,
      '',
      'DUDLEY x MOLLY LITTER PREFERENCES',
      '---------------------------------',
      `Preferred Window: ${litterTiming}`,
      `Sex Preference: ${sexPreference}`,
      `Primary Goals: ${primaryGoals}`,
      '',
      'EXPERIENCE & NOTES',
      '------------------',
      breedExperience,
    ]
      .filter((line) => line !== null)
      .join('\n');

    return { subject, body };
  }

  function attachApplicationHandler(formId: string, statusId?: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const { subject, body } = buildApplicationPayload(form);
      const mailtoUrl = `mailto:dog@cmejo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailtoUrl;

      if (statusId) {
        const statusEl = document.getElementById(statusId);
        if (statusEl) {
          statusEl.hidden = false;
          statusEl.textContent =
            '✓ Opening your email client addressed to dog@cmejo.com!';
        }
      }
    });
  }

  attachApplicationHandler('inline-puppy-app-form', 'inline-app-status');
  attachApplicationHandler('modal-puppy-app-form');

  // 6. Contact & Stud Inquiry Form Handler (mailto:dog@cmejo.com)
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactStatus = document.getElementById('contact-status');

  function buildContactPayload(form: HTMLFormElement) {
    const data = new FormData(form);
    const topic = (data.get('topic') || 'Kennel Inquiry').toString().trim();
    const name = (data.get('name') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();
    const phone = (data.get('phone') || 'Not provided').toString().trim();
    const city = (data.get('city') || '').toString().trim();
    const message = (data.get('message') || '').toString().trim();

    const subject = `[Qbits SWD Kennel NYC] ${topic} — ${name}`;
    const body = [
      `Inquiry Topic: ${topic}`,
      `Name: ${name}`,
      `Email: ${email}`,
      `Phone: ${phone}`,
      `City/State: ${city}`,
      '',
      'Message:',
      message,
    ].join('\n');

    return { subject, body };
  }

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        return;
      }
      const { subject, body } = buildContactPayload(contactForm);
      window.location.href = `mailto:dog@cmejo.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (contactStatus) {
        contactStatus.hidden = false;
        contactStatus.textContent =
          '✓ Opening your default mail app addressed to dog@cmejo.com!';
      }
    });
  }
</script>
