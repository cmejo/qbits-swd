---
import Layout from '../layouts/Layout.astro';
import {
  KENNEL_INFO,
  DOGS,
  STUD_SERVICE_HIGHLIGHTS,
  LITTER_ROADMAP,
  BREED_GUIDE_CARDS,
  FAQS,
} from '../data/kennelData';
---

<Layout>
  <!-- Top Editorial Announcement Bar -->
  <div class="announcement-bar" role="region" aria-label="Kennel Announcements">
    <div class="container announcement-inner">
      <p class="announcement-text">
        <span class="badge-pill">NYC PRESERVATION BREEDER</span>
        <strong>Dudley × Molly</strong> Planned Litters: <strong>Fall 2027 &amp; Spring 2028</strong> • Approved Stud Services Open
      </p>
      <div class="announcement-actions">
        <a href={KENNEL_INFO.applicationPdfUrl} download="Qbits-SWD-Puppy-Application.pdf" class="announcement-link">
          ↓ Fillable PDF Application
        </a>
        <span aria-hidden="true">•</span>
        <a href={`mailto:${KENNEL_INFO.email}`} class="announcement-link">{KENNEL_INFO.email}</a>
      </div>
    </div>
  </div>

  <!-- Sticky Navigation Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="#" class="brand-logo" aria-label="Qbits Spanish Water Dog Kennel Home">
        <span class="brand-crest" aria-hidden="true">Q</span>
        <div class="brand-text">
          <span class="brand-title">Qbits Kennel</span>
          <span class="brand-sub">Spanish Water Dogs • NYC</span>
        </div>
      </a>

      <nav class="primary-nav" aria-label="Primary Navigation">
        <a href="#our-dogs">Dudley &amp; Molly</a>
        <a href="#stud-services">Stud Services</a>
        <a href="#upcoming-litters">2027/2028 Litters</a>
        <a href="#breed-guide">The SWD Breed</a>
        <a href="#puppy-application">Puppy Application</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="header-cta-group">
        <button
          type="button"
          commandfor="puppy-app-dialog"
          command="show-modal"
          class="btn btn-primary btn-sm"
        >
          Apply for a Puppy
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- ====================================================================
         HERO SECTION (LCP Image optimized with fetchpriority="high")
         ==================================================================== -->
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">New York City • Perro de Agua Español</span>
          <h1 id="hero-heading" class="hero-title">
            Qbits Spanish Water Dog Kennel
          </h1>
          <p class="hero-lead">
            A boutique, home-raised preservation breeding program in the heart of <strong>New York City</strong>. Dedicated to health-tested, structurally balanced, and environmentally confident Spanish Water Dogs with authentic Iberian working heritage.
          </p>

          <div class="hero-highlights" role="list" aria-label="Kennel Highlights">
            <div class="highlight-chip" role="listitem">
              <span class="chip-label">Resident Sire</span>
              <strong>Dudley — Open for Approved Stud Services</strong>
            </div>
            <div class="highlight-chip" role="listitem">
              <span class="chip-label">Foundation Dam</span>
              <strong>Molly — Planned Litters Fall 2027 / Spring 2028</strong>
            </div>
          </div>

          <div class="hero-actions">
            <a href="#puppy-application" class="btn btn-primary">
              Complete Puppy Application
            </a>
            <a
              href={KENNEL_INFO.applicationPdfUrl}
              download="Qbits-SWD-Puppy-Application.pdf"
              class="btn btn-terracotta"
            >
              Download Fillable PDF Form
            </a>
            <a href="#stud-services" class="btn btn-outline">
              Explore Dudley’s Stud Services
            </a>
          </div>

          <p class="hero-note">
            <span>Direct Breeder Contact:</span>
            <a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a>
            <button
              type="button"
              class="inline-copy-btn"
              data-copy-email={KENNEL_INFO.email}
              aria-label="Copy breeder email address dog@cmejo.com to clipboard"
            >
              Copy Email
            </button>
          </p>
        </div>

        <div class="hero-media">
          <div class="hero-frame">
            <!-- MANDATORY per optimize-image-priority: fetchpriority="high" on LCP image, no loading="lazy" -->
            <img
              src={KENNEL_INFO.heroImage.src}
              alt={KENNEL_INFO.heroImage.alt}
              width={KENNEL_INFO.heroImage.width}
              height={KENNEL_INFO.heroImage.height}
              fetchpriority="high"
              class="hero-img"
            />
            <div class="hero-caption-card">
              <span class="caption-tag">EDITABLE STOCK PHOTOGRAPHY</span>
              <p>
                <strong>Dudley &amp; Molly • NYC</strong> — Replace photos anytime in <code>/public/images/</code> or <code>src/data/kennelData.ts</code>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         TRUST & ETHICS BAR (SEO / AEO Key Facts)
         ==================================================================== -->
    <section class="ethics-strip" aria-label="Breeding Standards and Ethics">
      <div class="container ethics-grid">
        <div class="ethics-item">
          <span class="ethics-num">OFA + CHIC</span>
          <p>Full hip, elbow, annual CAER eye &amp; DNA screening (prcd-PRA, NAD, CHG)</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">NYC Raised</span>
          <p>Whelped &amp; raised underfoot in Manhattan with Puppy Culture &amp; ENS protocols</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">Stud Services</span>
          <p>Dudley available via natural cover, fresh-chilled overnight, or frozen semen</p>
        </div>
        <div class="ethics-item">
          <span class="ethics-num">2027 / 2028</span>
          <p>Accepting early applications for Dudley × Molly Fall 2027 &amp; Spring 2028 litters</p>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         ABOUT QBITS KENNEL (NYC)
         ==================================================================== -->
    <section id="about" class="section" aria-labelledby="about-heading">
      <div class="container about-layout">
        <div class="about-header">
          <span class="eyebrow">01 • Our Philosophy in New York City</span>
          <h2 id="about-heading" class="section-title">
            Rustic Andalusian Heritage Meets New York City Poise
          </h2>
        </div>
        <div class="about-content">
          <p class="lead-paragraph">
            At <strong>Qbits Spanish Water Dog Kennel</strong>, we believe the best working and companion dogs are raised as integral members of daily family life—not in isolated kennel runs. Based on the Upper East Side of New York City, our Spanish Water Dogs (<em>Perro de Agua Español</em>) experience a rich tapestry of urban sights, Central Park trails, and weekend water work along the Northeast coast.
          </p>
          <p>
            Our breeding program is intentionally small and preservation-focused. By pairing our health-tested stud dog <strong>Dudley</strong> with our foundation bitch <strong>Molly</strong> for our planned <strong>Fall 2027 or Spring 2028</strong> litters, our goal is to produce sound, versatile puppies with the breed’s hallmark non-shedding rustic curls, athletic cobbiness, and deep devotion to their people.
          </p>
          <div class="about-pillars">
            <div class="pillar-card">
              <h3>Health Without Compromise</h3>
              <p>Every breeding dog completes OFA hip and elbow radiographs, annual board-certified ophthalmologist (CAER) exams, and breed-specific DNA panels before any pairing is considered.</p>
            </div>
            <div class="pillar-card">
              <h3>Temperament First</h3>
              <p>A true Spanish Water Dog is observant, intelligent, and loyal. We prioritize confident nerve strength and environmental resilience so our puppies thrive in busy cities and serene suburbs alike.</p>
            </div>
            <div class="pillar-card">
              <h3>Lifetime Breeder Partnership</h3>
              <p>From your first coat-shearing tutorial to lifelong training advice, Qbits Kennel stands behind every puppy we produce for the entirety of their life.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         MEET OUR DOGS: DUDLEY (STUD) & MOLLY (BITCH)
         ==================================================================== -->
    <section id="our-dogs" class="section section-sand" aria-labelledby="dogs-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">02 • Our Foundation Pair</span>
          <h2 id="dogs-heading" class="section-title">Meet Dudley &amp; Molly</h2>
          <p class="section-subtitle">
            Our resident sire <strong>Dudley</strong> and foundation bitch <strong>Molly</strong> represent complementary bloodlines, complete health clearances, and quintessential Spanish Water Dog type. <em>(All stats, pedigree names, and photos below are ready for you to customize.)</em>
          </p>
        </div>

        <div class="dogs-grid">
          {DOGS.map((dog) => (
            <article class="dog-card" id={`dog-${dog.id}`} aria-labelledby={`heading-${dog.id}`}>
              <div class="dog-media">
                <!-- Standard below-the-fold image: loading="lazy" ALONE (no fetchpriority="low" per optimize-image-priority) -->
                <img
                  src={dog.image.src}
                  alt={dog.image.alt}
                  width={dog.image.width}
                  height={dog.image.height}
                  loading="lazy"
                  class="dog-img"
                />
                <span class="dog-role-badge">{dog.badgeText}</span>
              </div>

              <div class="dog-body">
                <div class="dog-title-row">
                  <div>
                    <span class="dog-sex-label">{dog.sexRole}</span>
                    <h3 id={`heading-${dog.id}`} class="dog-callname">{dog.callName}</h3>
                  </div>
                  <span class="dog-dob">{dog.dob}</span>
                </div>

                <p class="dog-reg-name">{dog.registeredName}</p>
                <p class="dog-pedigree">{dog.sireAndDam}</p>

                <div class="dog-titles-list" aria-label={`${dog.callName} titles and certifications`}>
                  {dog.titles.map((t) => (
                    <span class="title-pill">{t}</span>
                  ))}
                </div>

                <dl class="dog-specs">
                  <div>
                    <dt>Coat &amp; Color</dt>
                    <dd>{dog.colorAndCoat}</dd>
                  </div>
                  <div>
                    <dt>Height &amp; Weight</dt>
                    <dd>{dog.heightWeight}</dd>
                  </div>
                </dl>

                <p class="dog-summary">{dog.summary}</p>
                <p class="dog-temperament">
                  <strong>Temperament &amp; Drive:</strong> {dog.temperamentNotes}
                </p>

                <div class="clearances-box">
                  <h4 class="clearances-heading">
                    <span>OFA &amp; Genetic Health Clearances</span>
                    <span class="chic-tag">CHIC Verified Protocol</span>
                  </h4>
                  <div class="clearances-grid">
                    {dog.clearances.map((c) => (
                      <div class="clearance-item">
                        <span class="clearance-test">{c.test}</span>
                        <strong class="clearance-result">{c.result}</strong>
                        <span class="clearance-code">{c.registryCode}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="dog-card-actions">
                  {dog.id === 'dudley' ? (
                    <a
                      href="#contact"
                      class="btn btn-primary"
                      data-select-inquiry="Stud Service Inquiry — Dudley"
                    >
                      Inquire About Dudley’s Stud Service
                    </a>
                  ) : (
                    <a
                      href="#puppy-application"
                      class="btn btn-terracotta"
                    >
                      Apply for Molly’s 2027/2028 Litter
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ====================================================================
         STUD SERVICES SECTION (DUDLEY)
         ==================================================================== -->
    <section id="stud-services" class="section section-forest" aria-labelledby="stud-heading">
      <div class="container">
        <div class="stud-layout">
          <div class="stud-intro">
            <span class="eyebrow" style="color: #E8A588;">03 • Approved Stud Services in NYC &amp; Nationwide</span>
            <h2 id="stud-heading" class="section-title">
              Standing at Stud: Dudley
            </h2>
            <p class="stud-lead">
              <strong>Dudley</strong> is available at stud to approved, health-tested Spanish Water Dog bitches held by ethical preservation breeders. Located in <strong>New York City</strong> with immediate access to premier reproductive veterinary specialists for progesterone timing, fresh-chilled collection, and overnight airport courier dispatch.
            </p>

            <div class="stud-cta-box">
              <h3>Request Dudley’s Stud Packet &amp; Pedigree</h3>
              <p>
                Send your bitch’s registered name, three-generation pedigree, OFA/CHIC health testing links, and anticipated season window directly to <a href={`mailto:${KENNEL_INFO.email}?subject=Stud%20Service%20Inquiry%20for%20Dudley%20-%20Qbits%20Kennel`} style="color: #FAF7F2; font-weight: 700;">{KENNEL_INFO.email}</a>.
              </p>
              <div class="stud-buttons">
                <a
                  href="#contact"
                  class="btn btn-terracotta"
                  data-select-inquiry="Stud Service Inquiry — Dudley"
                >
                  Open Stud Service Inquiry Form
                </a>
                <a
                  href={`mailto:${KENNEL_INFO.email}?subject=Stud%20Service%20Inquiry%20for%20Dudley%20(Qbits%20SWD%20Kennel)`}
                  class="btn btn-outline-light"
                >
                  Email {KENNEL_INFO.email} Directly
                </a>
              </div>
            </div>
          </div>

          <div class="stud-cards-grid">
            {STUD_SERVICE_HIGHLIGHTS.map((item, idx) => (
              <div class="stud-feature-card">
                <span class="stud-feature-num">0{idx + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         PLANNED LITTERS: FALL 2027 & SPRING 2028 (DUDLEY x MOLLY)
         ==================================================================== -->
    <section id="upcoming-litters" class="section" aria-labelledby="litters-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">04 • Planned Breeding Schedule</span>
          <h2 id="litters-heading" class="section-title">
            Upcoming Puppies: Fall 2027 &amp; Spring 2028
          </h2>
          <p class="section-subtitle">
            We are thoughtfully planning our upcoming litters between <strong>Dudley</strong> (Sire) and <strong>Molly</strong> (Dam) for <strong>Fall 2027</strong> or <strong>Spring 2028</strong>. Early applications allow us to get to know prospective families well before whelping.
          </p>
        </div>

        <div class="pairing-banner">
          <div class="pairing-parent">
            <span class="pairing-role">SIRE (STUD DOG)</span>
            <h3>Dudley</h3>
            <p>Athletic bone, tight espresso curls, rock-solid urban nerve &amp; full OFA CHIC clearances.</p>
          </div>
          <div class="pairing-cross" aria-hidden="true">×</div>
          <div class="pairing-parent">
            <span class="pairing-role">DAM (BITCH)</span>
            <h3>Molly</h3>
            <p>Intuitive scent drive, classic wooly curl coat, affectionate temperament &amp; full OFA clearances.</p>
          </div>
          <div class="pairing-summary">
            <span class="pairing-window-badge">EXPECTED WINDOWS: FALL 2027 / SPRING 2028</span>
            <h4>What We Expect From This Pairing</h4>
            <p>
              Versatile, medium-sized Spanish Water Dog puppies (expected 35–48 lbs at maturity) in rich brown and parti-factored coats with natural retrieve drive, high trainability, and affectionate family devotion.
            </p>
          </div>
        </div>

        <div class="roadmap-grid" role="list" aria-label="Litter Preparation and Rearing Timeline">
          {LITTER_ROADMAP.map((step) => (
            <div class="roadmap-card" role="listitem">
              <span class="roadmap-phase">{step.phase}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ====================================================================
         BREED GUIDE & NYC LIFESTYLE SECTION
         ==================================================================== -->
    <section id="breed-guide" class="section section-sand" aria-labelledby="breed-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">05 • About the Perro de Agua Español</span>
          <h2 id="breed-heading" class="section-title">
            The Spanish Water Dog: Rustic, Devoted &amp; Athletic
          </h2>
          <p class="section-subtitle">
            Before applying for a puppy, we encourage every family to understand what makes the Spanish Water Dog unique among water and herding breeds.
          </p>
        </div>

        <div class="breed-cards-grid">
          {BREED_GUIDE_CARDS.map((card) => (
            <article class="breed-card">
              <img
                src={card.image}
                alt={card.imageAlt}
                width="900"
                height="600"
                loading="lazy"
                class="breed-card-img"
              />
              <div class="breed-card-body">
                <span class="breed-category">{card.category}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="breed-specs-bar" aria-label="Spanish Water Dog Breed Specifications">
          <div>
            <span>AKC Group</span>
            <strong>Herding Group</strong>
          </div>
          <div>
            <span>Height Range</span>
            <strong>15.75" – 19.75"</strong>
          </div>
          <div>
            <span>Weight Range</span>
            <strong>30 – 50 lbs</strong>
          </div>
          <div>
            <span>Coat Type</span>
            <strong>Rustic Curly / Corded (Never Brushed)</strong>
          </div>
          <div>
            <span>Shedding</span>
            <strong>Minimal / Non-Shedding Single Coat</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================================
         PUPPY APPLICATION SECTION (ONLINE FORM + FILLABLE/PRINTABLE PDF)
         ==================================================================== -->
    <section id="puppy-application" class="section" aria-labelledby="application-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">06 • Prospective Puppy Family Questionnaire</span>
          <h2 id="application-heading" class="section-title">
            Apply for a Qbits Puppy (Online or Fillable PDF)
          </h2>
          <p class="section-subtitle">
            Whether you prefer to apply online right now or download our official <strong>fillable &amp; printable PDF application</strong> to complete at your leisure and email or mail in, we make the process clear and personal.
          </p>
        </div>

        <!-- Fillable & Printable PDF Callout Banner -->
        <div class="pdf-download-banner">
          <div class="pdf-banner-info">
            <span class="pdf-badge">OFFICIAL 2-PAGE FILLABLE &amp; PRINTABLE PDF</span>
            <h3>Prefer to Fill Out a PDF or Print &amp; Mail Your Application?</h3>
            <p>
              You can type directly into the fillable form fields on your computer and email it to <a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a>, or print it out, fill it in by hand, and mail or scan it back to us in New York City.
            </p>
          </div>
          <div class="pdf-banner-actions">
            <a
              href={KENNEL_INFO.applicationPdfUrl}
              download="Qbits-SWD-Puppy-Application.pdf"
              class="btn btn-terracotta"
            >
              ↓ Download Fillable PDF Application
            </a>
            <a
              href={KENNEL_INFO.applicationPdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
            >
              Open &amp; Print PDF in Browser ↗
            </a>
          </div>
        </div>

        <!-- Interactive Online Puppy Application Form -->
        <div class="application-card">
          <div class="application-card-header">
            <div>
              <h3>Interactive Online Puppy Application (Fall 2027 / Spring 2028)</h3>
              <p>Complete the fields below to generate a pre-formatted application email directly to <strong><a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a></strong>.</p>
            </div>
          </div>

          <form id="inline-puppy-app-form" class="puppy-app-form" novalidate>
            <fieldset class="form-fieldset">
              <legend>1. Applicant &amp; Household Details</legend>
              <div class="form-row-2">
                <div class="field">
                  <label for="app-name">Primary Applicant Full Name *</label>
                  <span id="app-name-hint" class="hint">Your legal first and last name</span>
                  <input
                    type="text"
                    id="app-name"
                    name="applicantName"
                    required
                    minlength="2"
                    autocomplete="name"
                    aria-describedby="app-name-hint"
                    aria-errormessage="app-name-error"
                  />
                  <div id="app-name-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter your full name.
                  </div>
                </div>

                <div class="field">
                  <label for="app-co-name">Co-Applicant / Partner Name</label>
                  <span id="app-co-name-hint" class="hint">Optional — if applying as a couple or family</span>
                  <input
                    type="text"
                    id="app-co-name"
                    name="coApplicantName"
                    aria-describedby="app-co-name-hint"
                  />
                </div>
              </div>

              <div class="form-row-3">
                <div class="field">
                  <label for="app-email">Email Address *</label>
                  <span id="app-email-hint" class="hint">Format: you@example.com</span>
                  <input
                    type="email"
                    id="app-email"
                    name="email"
                    required
                    autocomplete="email"
                    aria-describedby="app-email-hint"
                    aria-errormessage="app-email-error"
                  />
                  <div id="app-email-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter a valid email address.
                  </div>
                </div>

                <div class="field">
                  <label for="app-phone">Phone Number *</label>
                  <span id="app-phone-hint" class="hint">Format: (212) 555-0199</span>
                  <input
                    type="tel"
                    id="app-phone"
                    name="phone"
                    required
                    minlength="7"
                    autocomplete="tel"
                    aria-describedby="app-phone-hint"
                    aria-errormessage="app-phone-error"
                  />
                  <div id="app-phone-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter a contact phone number.
                  </div>
                </div>

                <div class="field">
                  <label for="app-location">City, State &amp; Neighborhood *</label>
                  <span id="app-location-hint" class="hint">e.g. Upper West Side, NYC or Westport, CT</span>
                  <input
                    type="text"
                    id="app-location"
                    name="location"
                    required
                    aria-describedby="app-location-hint"
                    aria-errormessage="app-location-error"
                  />
                  <div id="app-location-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please share your city and state.
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset class="form-fieldset">
              <legend>2. Home Environment &amp; Daily Schedule</legend>
              <div class="form-row-3">
                <div class="field">
                  <label for="app-housing">Residence Type *</label>
                  <span id="app-housing-hint" class="hint">Select your primary dwelling</span>
                  <select id="app-housing" name="housingType" required aria-describedby="app-housing-hint" aria-errormessage="app-housing-error">
                    <option value="">Select residence type...</option>
                    <option value="Apartment / Condo / Co-op">Apartment / Condo / Co-op</option>
                    <option value="Townhouse / Brownstone">Townhouse / Brownstone</option>
                    <option value="Single-Family House">Single-Family House</option>
                  </select>
                  <div id="app-housing-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please select your residence type.
                  </div>
                </div>

                <div class="field">
                  <label for="app-ownership">Own or Rent *</label>
                  <span id="app-ownership-hint" class="hint">Landlord/board approval required if renting</span>
                  <select id="app-ownership" name="ownership" required aria-describedby="app-ownership-hint" aria-errormessage="app-ownership-error">
                    <option value="">Select status...</option>
                    <option value="Own Residence">Own Residence</option>
                    <option value="Rent (Dog Approved by Landlord)">Rent (Dog Approved by Landlord)</option>
                  </select>
                  <div id="app-ownership-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please select ownership status.
                  </div>
