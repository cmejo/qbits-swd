            </a>
          </div>
        </div>

        <!-- Interactive Online Puppy Application Form (Netlify Forms + Mailto Backup) -->
        <div class="application-card">
          <div class="application-card-header">
            <div>
              <h3>Interactive Online Puppy &amp; Service Prospect Application (Fall 2027 / Spring 2028)</h3>
              <p>
                Complete the fields below to submit your application directly online or via email to <strong><a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a></strong>.
              </p>
            </div>
          </div>

          <form
            id="inline-puppy-app-form"
            name="qbits-puppy-application"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="puppy-app-form"
            novalidate
          >
            <input type="hidden" name="form-name" value="qbits-puppy-application" />
            <p hidden>
              <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
            </p>

            <fieldset class="form-fieldset">
              <legend>1. Applicant &amp; Household Details</legend>
              <div class="form-row-2">
                <div class="field">
                  <label for="app-name">Primary Applicant Full Name *</label>
                  <span id="app-name-hint" class="hint">Your legal first and last name</span>
                  <input
                    type="text"
                    id="app-name"
                    name="applicantName"
                    required
                    minlength="2"
                    autocomplete="name"
                    aria-describedby="app-name-hint"
                    aria-errormessage="app-name-error"
                  />
                  <div id="app-name-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter your full name.
                  </div>
                </div>

                <div class="field">
                  <label for="app-co-name">Co-Applicant / Caregiver / Partner Name</label>
                  <span id="app-co-name-hint" class="hint">Optional — if applying with a family member or support caregiver</span>
                  <input
                    type="text"
                    id="app-co-name"
                    name="coApplicantName"
                    aria-describedby="app-co-name-hint"
                  />
                </div>
              </div>

              <div class="form-row-3">
                <div class="field">
                  <label for="app-email">Email Address *</label>
                  <span id="app-email-hint" class="hint">Format: you@example.com</span>
                  <input
                    type="email"
                    id="app-email"
                    name="email"
                    required
                    autocomplete="email"
                    aria-describedby="app-email-hint"
                    aria-errormessage="app-email-error"
                  />
                  <div id="app-email-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter a valid email address.
                  </div>
                </div>

                <div class="field">
                  <label for="app-phone">Phone Number *</label>
                  <span id="app-phone-hint" class="hint">Format: (212) 555-0199</span>
                  <input
                    type="tel"
                    id="app-phone"
                    name="phone"
                    required
                    minlength="7"
                    autocomplete="tel"
                    aria-describedby="app-phone-hint"
                    aria-errormessage="app-phone-error"
                  />
                  <div id="app-phone-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please enter a contact phone number.
                  </div>
                </div>

                <div class="field">
                  <label for="app-location">City, State &amp; Neighborhood *</label>
                  <span id="app-location-hint" class="hint">e.g. Upper East Side, NYC or Greenwich, CT</span>
                  <input
                    type="text"
                    id="app-location"
                    name="location"
                    required
                    aria-describedby="app-location-hint"
                    aria-errormessage="app-location-error"
                  />
                  <div id="app-location-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please share your city and state.
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset class="form-fieldset">
              <legend>2. Home Environment &amp; Daily Schedule</legend>
              <div class="form-row-3">
                <div class="field">
                  <label for="app-housing">Residence Type *</label>
                  <span id="app-housing-hint" class="hint">Select your primary dwelling</span>
                  <select id="app-housing" name="housingType" required aria-describedby="app-housing-hint" aria-errormessage="app-housing-error">
                    <option value="">Select residence type...</option>
                    <option value="Apartment / Condo / Co-op">Apartment / Condo / Co-op</option>
                    <option value="Townhouse / Brownstone">Townhouse / Brownstone</option>
                    <option value="Single-Family House">Single-Family House</option>
                    <option value="Assisted Living / Accessible Senior Residence">Assisted Living / Accessible Senior Residence</option>
                  </select>
                  <div id="app-housing-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please select your residence type.
                  </div>
                </div>

                <div class="field">
                  <label for="app-ownership">Own or Rent *</label>
                  <span id="app-ownership-hint" class="hint">Note: Task-trained service dogs are exempt from pet bans under ADA/FHA</span>
                  <select id="app-ownership" name="ownership" required aria-describedby="app-ownership-hint" aria-errormessage="app-ownership-error">
                    <option value="">Select status...</option>
                    <option value="Own Residence">Own Residence</option>
                    <option value="Rent (Dog Approved by Landlord)">Rent (Dog Approved by Landlord)</option>
                    <option value="Rent (Applying for Task-Trained Service Dog)">Rent (Applying for Task-Trained Service Dog)</option>
                  </select>
                  <div id="app-ownership-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please select ownership status.
                  </div>
                </div>

                <div class="field">
                  <label for="app-hours-alone">Hours Dog Will Be Alone Daily *</label>
                  <span id="app-hours-hint" class="hint">e.g. Retired / Home full-time, Work from home, or 3–4 hrs</span>
                  <input
                    type="text"
                    id="app-hours-alone"
                    name="hoursAlone"
                    required
                    aria-describedby="app-hours-hint"
                    aria-errormessage="app-hours-error"
                  />
                  <div id="app-hours-error" class="error-msg">
                    <span aria-hidden="true">⚠</span> Please indicate daily schedule/hours alone.
                  </div>
                </div>
              </div>

              <div class="field">
                <label for="app-exercise">Yard / Outdoor Access &amp; Daily Exercise Plan *</label>
                <span id="app-exercise-hint" class="hint">Describe your yard/fencing, nearby parks, caregiver walk support, and daily routine</span>
                <textarea
