  /* Announcement Bar */
  .announcement-bar {
    background-color: var(--bg-forest);
    color: var(--text-on-dark);
    font-size: 0.9rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .announcement-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .announcement-text {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .badge-pill {
    background-color: var(--accent-terracotta);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.06em;
  }

  .announcement-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .announcement-link {
    color: var(--text-on-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Header & Responsive Senior-Accessible Navigation */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1.5px solid var(--border-stone);
  }

  html[data-contrast="high"] .site-header {
    background-color: #FFFFFF;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block: 0.75rem;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-espresso);
  }

  .brand-crest {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background-color: var(--accent-forest);
    color: var(--text-on-dark);
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* Navigation always visible & wraps cleanly on mobile, tablet, and 200% zoomed screens */
  .primary-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
    order: 3;
    width: 100%;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border-stone);
  }

  @media (min-width: 1080px) {
    .primary-nav {
      order: 0;
      width: auto;
      padding-top: 0;
      border-top: none;
    }
  }

  .primary-nav a {
    color: var(--text-slate);
    text-decoration: none;
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.45rem 0.35rem;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .primary-nav a:hover {
    color: var(--accent-terracotta);
    background-color: var(--bg-sand);
  }

  .primary-nav a.nav-highlight {
    color: var(--accent-forest);
    background-color: var(--bg-sand);
    padding-inline: 0.65rem;
    border: 1px solid var(--border-strong);
  }

  .btn-sm {
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    font-size: 0.92rem;
  }

  /* Hero */
  .hero-section {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 3.5rem;
    }
  }

  .hero-title {
    font-size: clamp(2.65rem, 5.2vw, 4.35rem);
    font-weight: 700;
    margin-bottom: 1.15rem;
    line-height: 1.08;
  }

  .hero-lead {
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    color: var(--text-slate);
    margin-bottom: 1.5rem;
    max-width: 62ch;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .highlight-chip {
    background-color: var(--bg-sand);
    border: 1.5px solid var(--border-stone);
    border-left: 5px solid var(--accent-forest);
    padding: 0.85rem 1.05rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.96rem;
  }

  .highlight-chip.chip-service {
    border-left-color: var(--accent-terracotta);
  }

  .highlight-chip a {
    color: var(--accent-forest);
    text-decoration: underline;
  }

  .chip-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.96rem;
    color: var(--text-muted);
    margin: 0;
  }

  .hero-note a {
    color: var(--accent-forest);
    font-weight: 700;
    text-decoration: underline;
  }

  .hero-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
    border: 1.5px solid var(--border-stone);
    background-color: var(--bg-sand);
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hero-caption-card {
    padding: 1.1rem 1.35rem;
    background: var(--bg-card);
    border-top: 1px solid var(--border-stone);
    font-size: 0.92rem;
    color: var(--text-slate);
  }

  .hero-caption-card p {
    margin: 0.25rem 0 0;
  }

  .caption-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-terracotta);
    letter-spacing: 0.08em;
  }

  /* Ethics Strip */
  .ethics-strip {
    background-color: var(--bg-sand);
    border-block: 1.5px solid var(--border-stone);
    padding-block: 2.25rem;
  }

  .ethics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .ethics-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ethics-num {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--accent-forest);
  }

  .ethics-item p {
    margin: 0;
    font-size: 0.96rem;
    color: var(--text-slate);
  }

  /* About Section */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .about-layout {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 3.5rem;
    }
  }

  .breeder-uvp-box {
    background: var(--bg-sand);
    border: 1.5px solid var(--border-strong);
    border-left: 5px solid var(--accent-terracotta);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    margin-top: 1.5rem;
  }

  .uvp-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-terracotta);
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .breeder-uvp-box p {
    margin: 0;
    font-size: 1rem;
    color: var(--text-espresso);
  }

  .breeder-uvp-box a {
    color: var(--accent-forest);
    text-decoration: underline;
  }

  .lead-paragraph {
    font-size: 1.18rem;
    color: var(--text-espresso);
    margin-top: 0;
  }

  .about-pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.35rem 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  .pillar-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
    color: var(--accent-forest);
  }

  .pillar-card p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-slate);
  }

  /* Service Animals & Gotham Paw Section */
  .urgent-service-banner {
    background: linear-gradient(135deg, #1C3B2F 0%, #142B22 100%);
    border: 2px solid #F3B398;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-elevated);
  }

  .urgent-service-copy {
    max-width: 720px;
  }

  .urgent-pill {
    display: inline-block;
    background: var(--accent-terracotta);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    letter-spacing: 0.06em;
    margin-bottom: 0.65rem;
  }

  .urgent-service-copy h3 {
    font-size: clamp(1.55rem, 2.8vw, 2rem);
    color: #FFFFFF;
    margin-bottom: 0.6rem;
  }

  .urgent-service-copy p {
    margin: 0;
    font-size: 1.02rem;
    color: var(--text-on-dark-muted);
  }

  .urgent-service-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .service-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.35rem;
    margin-bottom: 3rem;
  }

  .service-card {
    background: var(--bg-forest-elevated);
    border: 1.5px solid rgba(250, 247, 242, 0.22);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .service-card-badge {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #F3B398;
    margin-bottom: 0.5rem;
  }

  .service-card h3 {
    font-size: 1.4rem;
    color: #FFFFFF;
    margin-bottom: 0.55rem;
  }

  .service-card p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-on-dark-muted);
  }

  /* Assistance Dog Comparison Table */
  .comparison-wrapper {
    background: var(--bg-card);
    color: var(--text-espresso);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 2px solid var(--border-strong);
    box-shadow: var(--shadow-elevated);
  }

  .comparison-intro {
    max-width: 820px;
    margin-bottom: 1.5rem;
  }

  .comparison-intro h3 {
    color: var(--text-espresso);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin-bottom: 0.5rem;
  }

  .comparison-intro p {
    margin: 0;
    color: var(--text-slate);
    font-size: 1.02rem;
  }

  .table-scroll-container {
    overflow-x: auto;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-md);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 760px;
    font-variant-numeric: tabular-nums;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 1.1rem 1.15rem;
    border-bottom: 1px solid var(--border-stone);
    vertical-align: top;
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .comparison-table thead th {
    background: var(--bg-sand);
    color: var(--text-espresso);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 2px solid var(--border-strong);
  }

  .comparison-table tbody tr:last-child th,
  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tbody tr:nth-child(even) {
    background-color: var(--bg-alabaster);
  }

  .row-type-cell {
    color: var(--accent-forest);
    font-family: var(--font-sans);
    width: 19%;
  }

  /* Dogs Section */
  .dogs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 980px) {
    .dogs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dog-card {
    background: var(--bg-card);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
  }

  .dog-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-sand);
  }

  .dog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dog-role-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(20, 43, 34, 0.94);
    color: var(--text-on-dark);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
  }

  .dog-body {
    padding: clamp(1.5rem, 3vw, 2.15rem);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dog-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dog-sex-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-terracotta);
    font-weight: 700;
  }

  .dog-callname {
    font-size: 2.4rem;
    margin: 0.1rem 0 0.25rem;
  }

  .dog-dob {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    background: var(--bg-sand);
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    color: var(--text-slate);
    font-weight: 600;
  }

  .dog-reg-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--text-slate);
    margin: 0 0 0.25rem;
  }

  .dog-pedigree {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .dog-titles-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .title-pill {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    background: var(--bg-alabaster);
    border: 1px solid var(--border-strong);
    color: var(--accent-forest);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .dog-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    background: var(--bg-alabaster);
    border: 1px solid var(--border-stone);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1rem;
    margin: 0 0 1.15rem;
  }

  .dog-specs dt {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
  }

  .dog-specs dd {
    margin: 0.15rem 0 0;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--text-espresso);
  }

  .dog-summary,
  .dog-temperament {
    font-size: 1rem;
    color: var(--text-slate);
    margin: 0 0 0.95rem;
  }

  .clearances-box {
    background: var(--bg-alabaster);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.05rem 1.2rem;
    margin-top: auto;
    margin-bottom: 1.4rem;
  }

  .clearances-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .chic-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--valid-green);
    background: var(--valid-bg);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .clearances-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }

  .clearance-item {
    background: #FFFFFF;
    border: 1px solid var(--border-stone);
    border-radius: 6px;
    padding: 0.5rem 0.7rem;
    display: flex;
    flex-direction: column;
  }

  .clearance-test {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .clearance-result {
    font-size: 0.9rem;
    color: var(--accent-forest);
  }

  .clearance-code {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  /* Stud Section */
  .stud-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .stud-layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .stud-lead {
    font-size: 1.1rem;
    color: var(--text-on-dark-muted);
    margin-bottom: 1.75rem;
  }

  .stud-cta-box {
    background: var(--bg-forest-elevated);
    border: 1.5px solid rgba(250, 247, 242, 0.24);
    border-radius: var(--radius-md);
    padding: 1.6rem;
  }

  .stud-cta-box h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .stud-cta-box p {
    color: var(--text-on-dark-muted);
    font-size: 0.98rem;
    margin-bottom: 1.25rem;
  }

  .stud-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stud-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .stud-feature-card {
    background: var(--bg-forest-elevated);
    border: 1.5px solid rgba(250, 247, 242, 0.18);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.55rem;
  }

  .stud-feature-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #F3B398;
    font-weight: 700;
  }

  .stud-feature-card h3 {
    font-size: 1.35rem;
    margin: 0.25rem 0 0.4rem;
  }

  .stud-feature-card p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-on-dark-muted);
  }

  /* Litters & Pairing */
  .pairing-banner {
    background: var(--bg-sand);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .pairing-banner {
      grid-template-columns: 1fr auto 1fr 1.3fr;
    }
  }

  .pairing-parent {
    background: var(--bg-card);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.3rem;
  }

  .pairing-role {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent-terracotta);
    font-weight: 700;
  }

  .pairing-parent h3 {
    font-size: 1.9rem;
    margin: 0.15rem 0 0.35rem;
  }

  .pairing-parent p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-slate);
  }

  .pairing-cross {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--accent-terracotta);
    text-align: center;
    font-weight: 700;
  }

  .pairing-window-badge {
    display: inline-block;
    background: var(--accent-forest);
    color: var(--text-on-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .pairing-summary h4 {
