  }
  .guide-cta-banner {
    background: var(--bg-forest);
    color: var(--text-on-dark);
    border-radius: var(--radius-md);
    padding: 1.75rem 2rem;
    margin-top: 2.5rem;
  }
  .related-guides h2 {
    font-size: 1.8rem;
    margin-bottom: 1.25rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .related-item {
    background: var(--bg-card);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-md);
    padding: 1.35rem;
  }
  .related-item h3 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }
  .related-item h3 a {
    color: var(--accent-forest);
    text-decoration: underline;
  }
  .related-item p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-slate);
  }
  .site-footer {
    background-color: var(--bg-forest);
    color: var(--text-on-dark);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(250, 247, 242, 0.16);
  }
  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  .footer-desc {
    color: var(--text-on-dark-muted);
    font-size: 0.96rem;
    max-width: 48ch;
  }
  .footer-email a {
    color: #F3B398;
    font-weight: 700;
  }
  .footer-links h3 {
    color: var(--text-on-dark);
    font-size: 1.25rem;
    margin-bottom: 0.85rem;
  }
  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-links a {
    color: var(--text-on-dark-muted);
    text-decoration: none;
    font-size: 0.96rem;
  }
  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-on-dark-muted);
  }
</style>

<script>
  const textButtons = document.querySelectorAll<HTMLButtonElement>('[data-set-text]');
  const contrastBtn = document.querySelector<HTMLButtonElement>('[data-toggle-contrast]');

  function syncToolbarState() {
    const currentSize = document.documentElement.getAttribute('data-text-size') || 'normal';
    const isHighContrast = document.documentElement.getAttribute('data-contrast') === 'high';
    textButtons.forEach((btn) => {
      const btnSize = btn.getAttribute('data-set-text') || 'normal';
      btn.setAttribute('aria-pressed', btnSize === currentSize ? 'true' : 'false');
    });
    if (contrastBtn) {
      contrastBtn.setAttribute('aria-pressed', isHighContrast ? 'true' : 'false');
    }
  }
  syncToolbarState();

  textButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = btn.getAttribute('data-set-text') || 'normal';
      if (size === 'normal') {
        document.documentElement.removeAttribute('data-text-size');
      } else {
        document.documentElement.setAttribute('data-text-size', size);
      }
      try {
        localStorage.setItem('qbits-text-size', size);
      } catch {}
      syncToolbarState();
    });
  });

  if (contrastBtn) {
    contrastBtn.addEventListener('click', () => {
      const isHigh = document.documentElement.getAttribute('data-contrast') === 'high';
      if (isHigh) {
        document.documentElement.removeAttribute('data-contrast');
        try {
          localStorage.setItem('qbits-contrast', 'normal');
        } catch {}
      } else {
        document.documentElement.setAttribute('data-contrast', 'high');
        try {
          localStorage.setItem('qbits-contrast', 'high');
        } catch {}
      }
      syncToolbarState();
    });
  }
</script>
