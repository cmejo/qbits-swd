---
import Layout from '../../layouts/Layout.astro';
import { KENNEL_INFO, SEO_LANDING_PAGES, type SeoLandingPage } from '../../data/kennelData';

export function getStaticPaths() {
  return SEO_LANDING_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: SeoLandingPage;
}

const { page } = Astro.props;
const relatedPages = SEO_LANDING_PAGES.filter((p) => p.slug !== page.slug);

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${KENNEL_INFO.siteUrl}/guides/${page.slug}#article`,
      headline: page.title,
      description: page.metaDescription,
      articleSection: page.category,
      inLanguage: 'en-US',
      author: {
        '@id': `${KENNEL_INFO.siteUrl}/#organization`,
      },
      publisher: {
        '@id': `${KENNEL_INFO.siteUrl}/#organization`,
      },
      mainEntityOfPage: `${KENNEL_INFO.siteUrl}/guides/${page.slug}`,
      datePublished: '2026-10-25',
      dateModified: '2026-10-25',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Qbits Spanish Water Dog Kennel NYC',
          item: KENNEL_INFO.siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Educational Guides',
          item: `${KENNEL_INFO.siteUrl}/#guides`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: page.title,
          item: `${KENNEL_INFO.siteUrl}/guides/${page.slug}`,
        },
      ],
    },
  ],
};
---

<Layout title={page.metaTitle} description={page.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <!-- Senior-Friendly Accessibility & Reading Comfort Toolbar -->
  <div class="a11y-toolbar" role="region" aria-label="Reading Comfort and Text Size Controls">
    <div class="container a11y-toolbar-inner">
      <span class="a11y-label">
        <span aria-hidden="true">👁</span> Reading Comfort &amp; Text Size:
      </span>
      <div class="a11y-controls">
        <button type="button" class="a11y-btn" data-set-text="normal" aria-pressed="true">
          A Standard
        </button>
        <button type="button" class="a11y-btn" data-set-text="large" aria-pressed="false">
          A+ Larger Text
        </button>
        <button type="button" class="a11y-btn" data-set-text="xlarge" aria-pressed="false">
          A++ Extra Large
        </button>
        <button type="button" class="a11y-btn" data-toggle-contrast aria-pressed="false">
          ◐ High Contrast
        </button>
      </div>
    </div>
  </div>

  <!-- Top Announcement Bar -->
  <div class="announcement-bar" role="region" aria-label="Kennel Announcements">
    <div class="container announcement-inner">
      <p class="announcement-text">
        <span class="badge-pill">1 OF ONLY 5 SWD BREEDERS IN AMERICA</span>
        <strong>Mentored by Lisa Harper</strong> • Planned Litters: <strong>Fall 2027 &amp; Spring 2028</strong> • Service Dogs via Gotham Paw
      </p>
      <div class="announcement-actions">
        <a
          href={KENNEL_INFO.gothamPawUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="announcement-link"
        >
          Gotham Paw Service Dogs ↗
        </a>
        <span aria-hidden="true">•</span>
        <a href={KENNEL_INFO.applicationPdfUrl} download="Qbits-SWD-Puppy-Application.pdf" class="announcement-link">
          ↓ Fillable PDF Application
        </a>
        <span aria-hidden="true">•</span>
        <a href={`mailto:${KENNEL_INFO.email}`} class="announcement-link">{KENNEL_INFO.email}</a>
      </div>
    </div>
  </div>

  <!-- Sticky Navigation Header -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" aria-label="Qbits Spanish Water Dog Kennel Home">
        <span class="brand-crest" aria-hidden="true">Q</span>
        <div class="brand-text">
          <span class="brand-title">Qbits Kennel</span>
          <span class="brand-sub">Upper East Side • NYC</span>
        </div>
      </a>

      <nav class="primary-nav" aria-label="Primary">
        <a href="/#service-animals" class="nav-highlight">Service &amp; Therapy Dogs</a>
        <a href="/#our-dogs">Dudley &amp; Molly</a>
        <a href="/#stud-services">Stud Services</a>
        <a href="/#upcoming-litters">2027/2028 Litters</a>
        <a href="/#breed-guide">The SWD Breed</a>
        <a href="/#puppy-application">Puppy Application</a>
        <a href="/#faq">FAQ</a>
        <a href="/#contact">Contact</a>
      </nav>

      <div class="header-cta-group">
        <a href="/#puppy-application" class="btn btn-primary btn-sm">
          Apply Now
        </a>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1" class="guide-page">
    <div class="container guide-container">
      <nav aria-label="Breadcrumb" class="breadcrumb-nav">
        <a href="/">Qbits Kennel NYC Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#guides">Educational Guides</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{page.category}</span>
      </nav>

      <header class="guide-header">
        <span class="eyebrow">{page.category} • Upper East Side, NYC</span>
        <h1 class="guide-title">{page.title}</h1>
        <p class="guide-lead">{page.heroLead}</p>

        <div class="guide-hero-actions">
          <a href={page.ctaHref} class="btn btn-primary">
            {page.ctaText}
          </a>
          <a
            href={KENNEL_INFO.gothamPawUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-terracotta"
          >
            Visit Gotham Paw Service Dogs ↗
          </a>
          <a
            href={KENNEL_INFO.applicationPdfUrl}
            download="Qbits-SWD-Puppy-Application.pdf"
            class="btn btn-outline"
          >
            ↓ Download Fillable PDF Form
          </a>
          <a
            href={KENNEL_INFO.clinicalBrochurePdfUrl}
            download="Qbits-Clinical-Service-Dog-Brochure.pdf"
            class="btn btn-outline"
          >
            ↓ Clinical Brochure (PDF)
          </a>
        </div>
      </header>

      <article class="guide-card">
        {page.sections.map((sec) => (
          <section class="guide-section">
            <h2>{sec.heading}</h2>
            {sec.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}

        <div class="guide-cta-banner">
          <div>
            <span class="eyebrow" style="color: #F3B398;">Next Steps • Reach Out Early</span>
            <h2 style="color: #FFFFFF; margin-bottom: 0.5rem;">
              Speak Directly With Qbits Spanish Water Dog Kennel &amp; Gotham Paw
            </h2>
            <p style="color: var(--text-on-dark-muted); margin: 0;">
              As <strong>one of only 5 Spanish Water Dog breeders in America</strong>—mentored by breed pioneer <strong>Lisa Harper</strong> and specializing in neurological and spinal cord injury service animals—we review inquiries personally. Email <a href={`mailto:${KENNEL_INFO.email}`} style="color: #FFFFFF; font-weight: 700;">{KENNEL_INFO.email}</a> or submit our online application today.
            </p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem;">
            <a href="/#puppy-application" class="btn btn-terracotta">
              Complete Online Application
            </a>
            <a href={`mailto:${KENNEL_INFO.email}?subject=${encodeURIComponent(page.inquiryTopic)}`} class="btn btn-outline-light">
              Email {KENNEL_INFO.email} Directly ✉
            </a>
          </div>
        </div>
      </article>

      <aside class="related-guides" aria-labelledby="related-guides-heading">
        <h2 id="related-guides-heading">Explore More Spanish Water Dog &amp; Service Animal Guides</h2>
        <div class="related-grid">
          {relatedPages.map((rel) => (
            <div class="related-item">
              <span class="eyebrow" style="margin-bottom: 0.35rem;">{rel.category}</span>
              <h3>
                <a href={`/guides/${rel.slug}`}>{rel.title}</a>
              </h3>
              <p>{rel.metaDescription}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="brand-logo" style="color: var(--text-on-dark); margin-bottom: 0.75rem;">
          <span class="brand-crest" style="background: var(--accent-terracotta);">Q</span>
          <div class="brand-text">
            <span class="brand-title" style="color: var(--text-on-dark);">Qbits Spanish Water Dog Kennel</span>
            <span class="brand-sub" style="color: var(--text-on-dark-muted);">Upper East Side, NYC • Perro de Agua Español</span>
          </div>
        </div>
        <p class="footer-desc">
          One of only 5 Spanish Water Dog breeders in America, mentored by breed pioneer <strong>Lisa Harper</strong>. Partnered with <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer" style="color: #F3B398; font-weight: 700;">Gotham Paw</a> for spinal cord injury &amp; neuromuscular service dogs.
        </p>
        <p class="footer-email">
          Direct Email: <a href={`mailto:${KENNEL_INFO.email}`}>{KENNEL_INFO.email}</a>
        </p>
      </div>

      <div class="footer-links">
        <h3>Quick Navigation</h3>
        <ul>
          <li><a href="/#about">About Qbits Kennel NYC</a></li>
          <li><a href="/#service-animals">Service &amp; Therapy Dogs</a></li>
          <li><a href="/#our-dogs">Meet Dudley &amp; Molly</a></li>
          <li><a href="/#stud-services">Dudley Stud Services</a></li>
          <li><a href="/#upcoming-litters">Fall 2027 / Spring 2028 Litters</a></li>
          <li><a href="/#puppy-application">Online Application</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3>Resources &amp; GDPR Privacy</h3>
        <ul>
          <li>
            <a href={KENNEL_INFO.gothamPawUrl} target="_blank" rel="noopener noreferrer">
              Gotham Paw Service Animal Training ↗
            </a>
          </li>
          <li>
            <a href={KENNEL_INFO.applicationPdfUrl} download="Qbits-SWD-Puppy-Application.pdf">
              Download Fillable PDF Application
            </a>
          </li>
          <li><a href="/privacy">GDPR &amp; Privacy Policy</a></li>
          <li>
            <button
              type="button"
              commandfor="gdpr-consent-dialog"
              command="show-modal"
              style="background: none; border: none; padding: 0; color: var(--text-on-dark-muted); font: inherit; font-size: 0.96rem; text-decoration: underline; cursor: pointer;"
            >
              ⚙ Manage GDPR &amp; Cookie Preferences
            </button>
          </li>
          <li><a href={`mailto:${KENNEL_INFO.email}`}>Email {KENNEL_INFO.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="container footer-bottom">
      <p>© {new Date().getFullYear()} {KENNEL_INFO.name} (Upper East Side, New York City, NY). All rights reserved. • <a href="/privacy" style="color: var(--text-on-dark-muted); text-decoration: underline;">GDPR &amp; Privacy Policy</a></p>
      <p>Dedicated to the Spanish Water Dog (<em>Perro de Agua Español</em>) &amp; Medical Service Work.</p>
    </div>
  </footer>
</Layout>

<style>
  .announcement-bar {
    background-color: var(--bg-forest);
    color: var(--text-on-dark);
    font-size: 0.9rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .announcement-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .announcement-text {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .badge-pill {
    background-color: var(--accent-terracotta);
    color: #FFFFFF;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.06em;
  }
  .announcement-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  .announcement-link {
    color: var(--text-on-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1.5px solid var(--border-stone);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block: 0.75rem;
  }
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-espresso);
  }
  .brand-crest {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background-color: var(--accent-forest);
    color: var(--text-on-dark);
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .primary-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
    order: 3;
    width: 100%;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border-stone);
  }
  @media (min-width: 1080px) {
    .primary-nav {
      order: 0;
      width: auto;
      padding-top: 0;
      border-top: none;
    }
  }
  .primary-nav a {
    color: var(--text-slate);
    text-decoration: none;
    font-size: 0.96rem;
    font-weight: 700;
    padding: 0.45rem 0.35rem;
    border-radius: 6px;
  }
  .primary-nav a.nav-highlight {
    color: var(--accent-forest);
    background-color: var(--bg-sand);
    padding-inline: 0.65rem;
    border: 1px solid var(--border-strong);
  }
  .btn-sm {
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    font-size: 0.92rem;
  }
  .guide-page {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .guide-container {
    max-width: 920px;
  }
  .breadcrumb-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb-nav a {
    color: var(--accent-forest);
    font-weight: 600;
  }
  .guide-header {
    margin-bottom: 2.5rem;
  }
  .guide-title {
    font-size: clamp(2.25rem, 4.2vw, 3.35rem);
    margin-bottom: 1rem;
  }
  .guide-lead {
    font-size: 1.18rem;
    color: var(--text-slate);
    margin-bottom: 1.5rem;
    max-width: 68ch;
  }
  .guide-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .guide-card {
    background: var(--bg-card);
    border: 1.5px solid var(--border-stone);
    border-radius: var(--radius-lg);
