    box-shadow: var(--shadow-soft);
    margin-bottom: 3rem;
  }
  .guide-section {
    margin-bottom: 2.25rem;
  }
  .guide-section h2 {
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
    color: var(--accent-forest);
    margin-bottom: 0.75rem;
