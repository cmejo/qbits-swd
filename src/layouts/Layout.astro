---
import '../styles/global.css';
import { KENNEL_INFO, FAQS } from '../data/kennelData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Qbits Spanish Water Dog Kennel | NYC Service Dog Breeder, Stud Services & 2027/2028 Litters',
  description = 'Qbits Spanish Water Dog Kennel on the Upper East Side of NYC. Specializing in task-trained service dogs for spinal cord injuries & neuromuscular disorders (partnered with Gotham Paw), therapy dogs, approved stud services with Dudley, and planned litters with Molly (Fall 2027 / Spring 2028).',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, KENNEL_INFO.siteUrl);

// Rich Structured Data (Schema.org JSON-LD) for Google Rich Results, Local SEO, SEM & AI Search Engines
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'Organization'],
      '@id': `${KENNEL_INFO.siteUrl}/#organization`,
      name: KENNEL_INFO.name,
      alternateName: [
        'Qbits Kennel NYC',
        'Qbits Spanish Water Dogs',
        'Qbits Service Dog Breeding Program',
        'Qbits Perro de Agua Español',
      ],
      url: KENNEL_INFO.siteUrl,
      sameAs: [KENNEL_INFO.gothamPawUrl],
      logo: `${KENNEL_INFO.siteUrl}/favicon.svg`,
      image: `${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`,
      description,
      email: KENNEL_INFO.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Upper East Side',
        addressLocality: 'New York',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 40.7736,
        longitude: -73.9566,
      },
      areaServed: [
        { '@type': 'City', name: 'New York City' },
        { '@type': 'AdministrativeArea', name: 'New York' },
        { '@type': 'Country', name: 'United States' },
      ],
      knowsAbout: [
        'Spanish Water Dog',
        'Perro de Agua Español',
        'Task-Trained Mobility & Neurological Service Dogs',
        'Spinal Cord Injury Service Animals',
        'Neuromuscular Disorder Assistance Dogs (Cerebral Palsy, Multiple Sclerosis)',
        'Facility & Hospital Therapy Dogs',
        'Canine Stud Services',
        'OFA CHIC Health Tested Dog Breeding',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Qbits Spanish Water Dog Service Animal, Breeding & Stud Services',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Task-Trained Service Animal Prospects (Spinal Cord Injury & Neuromuscular Disorders)',
              url: KENNEL_INFO.gothamPawUrl,
              description:
                'At least one puppy from every Qbits Spanish Water Dog litter is transferred into our Service Animal Program in partnership with Gotham Paw, specializing in task-trained service dogs for spinal cord injuries, Cerebral Palsy, Multiple Sclerosis, and neurological conditions.',
              provider: { '@id': `${KENNEL_INFO.siteUrl}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Spanish Water Dog Stud Services — Dudley',
              description:
                'Approved stud services with our health-tested, service-proven Spanish Water Dog sire Dudley (natural cover in NYC, fresh-chilled overnight shipping, or frozen semen).',
              provider: { '@id': `${KENNEL_INFO.siteUrl}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            availability: 'https://schema.org/PreOrder',
            itemOffered: {
              '@type': 'Product',
              name: 'Planned Spanish Water Dog Litters (Dudley × Molly — Fall 2027 & Spring 2028)',
              description:
                'Home-raised, health-tested Spanish Water Dog puppies from sire Dudley and dam Molly on the Upper East Side of New York City, planned for Fall 2027 and Spring 2028 for service, therapy, and devoted family companion homes.',
              brand: {
                '@type': 'Brand',
                name: KENNEL_INFO.name,
              },
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${KENNEL_INFO.siteUrl}/#faq`,
      mainEntity: FAQS.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer.replace(/<[^>]*>/g, ''),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY per respect-os-text-scale: opt in to OS-level text scaling -->
    <meta name="text-scale" content="scale" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO & Geo Meta Tags for Upper East Side, New York City -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={KENNEL_INFO.name} />
    <meta name="keywords" content="Spanish Water Dog breeder NYC, Spanish Water Dog service dog, spinal cord injury service dog, Multiple Sclerosis service dog, Cerebral Palsy service dog, Gotham Paw service animal, Therapy dog Spanish Water Dog, Perro de Agua Español breeder, Qbits Spanish Water Dog Kennel, Spanish Water Dog stud service, Dudley Spanish Water Dog, Molly Spanish Water Dog, Fall 2027 Spring 2028 puppies" />
    <meta name="geo.region" content="US-NY" />
    <meta name="geo.placename" content="Upper East Side, New York City" />
    <meta name="geo.position" content="40.7736;-73.9566" />
    <meta name="ICBM" content="40.7736, -73.9566" />

    <!-- OpenGraph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={KENNEL_INFO.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />
    <meta property="og:image:alt" content={KENNEL_INFO.heroImage.alt} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />

    <!-- AI / LLM Discovery Links (llmstxt.org standard) -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Qbits Kennel LLM Summary" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Qbits Kennel Full LLM Knowledge Base" />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#142B22" />

    <!-- Fast Google Fonts with preconnect and display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Restore Senior Accessibility Reading Preferences before first paint -->
    <script is:inline>
      try {
        const savedSize = localStorage.getItem('qbits-text-size');
        const savedContrast = localStorage.getItem('qbits-contrast');
        if (savedSize === 'large' || savedSize === 'xlarge') {
          document.documentElement.setAttribute('data-text-size', savedSize);
        }
        if (savedContrast === 'high') {
          document.documentElement.setAttribute('data-contrast', 'high');
        }
      } catch {}
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
