---
import '../styles/global.css';
import { KENNEL_INFO, DOGS, FAQS } from '../data/kennelData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Qbits Spanish Water Dog Kennel | NYC Breeder, Stud Services & Planned Litters (Fall 2027 / Spring 2028)',
  description = 'Qbits Spanish Water Dog Kennel in New York City. Preservation-bred Perro de Agua Español featuring health-tested stud dog Dudley and foundation bitch Molly. Approved stud services & planned puppies in Fall 2027 / Spring 2028.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, KENNEL_INFO.siteUrl);

// Rich Structured Data (Schema.org JSON-LD) for Google Rich Results, Local SEO, SEM & AI Search Engines
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'Organization'],
      '@id': `${KENNEL_INFO.siteUrl}/#organization`,
      name: KENNEL_INFO.name,
      alternateName: ['Qbits Kennel NYC', 'Qbits Spanish Water Dogs', 'Qbits Perro de Agua Español'],
      url: KENNEL_INFO.siteUrl,
      logo: `${KENNEL_INFO.siteUrl}/favicon.svg`,
      image: `${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`,
      description,
      email: KENNEL_INFO.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'New York',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 40.7831,
        longitude: -73.9712,
      },
      areaServed: [
        { '@type': 'City', name: 'New York City' },
        { '@type': 'AdministrativeArea', name: 'New York' },
        { '@type': 'Country', name: 'United States' },
      ],
      knowsAbout: [
        'Spanish Water Dog',
        'Perro de Agua Español',
        'AKC Herding Group Dogs',
        'Canine Stud Services',
        'OFA CHIC Health Tested Dog Breeding',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Qbits Spanish Water Dog Breeding & Stud Services',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Spanish Water Dog Stud Services — Dudley',
              description:
                'Approved stud services with our health-tested Spanish Water Dog sire Dudley (natural cover in NYC, fresh-chilled overnight shipping, or frozen semen).',
              provider: { '@id': `${KENNEL_INFO.siteUrl}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            availability: 'https://schema.org/PreOrder',
            itemOffered: {
              '@type': 'Product',
              name: 'Planned Spanish Water Dog Litters (Dudley × Molly — Fall 2027 & Spring 2028)',
              description:
                'Home-raised, health-tested Spanish Water Dog puppies from sire Dudley and dam Molly in New York City, planned for Fall 2027 and Spring 2028.',
              brand: {
                '@type': 'Brand',
                name: KENNEL_INFO.name,
              },
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${KENNEL_INFO.siteUrl}/#faq`,
      mainEntity: FAQS.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO & Geo Meta Tags for New York City -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={KENNEL_INFO.name} />
    <meta name="keywords" content="Spanish Water Dog breeder NYC, Spanish Water Dog puppies New York, Perro de Agua Español breeder, Qbits Spanish Water Dog Kennel, Spanish Water Dog stud service, Dudley Spanish Water Dog, Molly Spanish Water Dog, Fall 2027 Spring 2028 puppies" />
    <meta name="geo.region" content="US-NY" />
    <meta name="geo.placename" content="New York City" />
    <meta name="geo.position" content="40.7831;-73.9712" />
    <meta name="ICBM" content="40.7831, -73.9712" />

    <!-- OpenGraph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={KENNEL_INFO.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />
    <meta property="og:image:alt" content={KENNEL_INFO.heroImage.alt} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />

    <!-- AI / LLM Discovery Links (llmstxt.org standard) -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Qbits Kennel LLM Summary" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Qbits Kennel Full LLM Knowledge Base" />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1E3F32" />

    <!-- Fast Google Fonts with preconnect and display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
