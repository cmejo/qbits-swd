---
import '../styles/global.css';
import { KENNEL_INFO, FAQS } from '../data/kennelData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Qbits Spanish Water Dog Kennel | 1 of 5 US Breeders, NYC Service Dogs (Gotham Paw) & Stud Services',
  description = 'Qbits Spanish Water Dog Kennel on the Upper East Side of NYC—one of only 5 Spanish Water Dog breeders in America, mentored by breed pioneer Lisa Harper. Specializing in task-trained service dogs for spinal cord injuries & neuromuscular disorders (Gotham Paw), approved stud services with Dudley, and Fall 2027 / Spring 2028 litters with Molly.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, KENNEL_INFO.siteUrl);

// Rich Structured Data (Schema.org JSON-LD) for Google Rich Results, Local SEO, SEM & AI Search Engines
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'Organization'],
      '@id': `${KENNEL_INFO.siteUrl}/#organization`,
      name: KENNEL_INFO.name,
      alternateName: [
        'Qbits Kennel NYC',
        'Qbits Spanish Water Dogs',
        'Qbits Service Dog Breeding Program',
        'Qbits Perro de Agua Español',
      ],
      url: KENNEL_INFO.siteUrl,
      sameAs: [KENNEL_INFO.gothamPawUrl],
      logo: `${KENNEL_INFO.siteUrl}/favicon.svg`,
      image: `${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`,
      description,
      email: KENNEL_INFO.email,
      founder: {
        '@type': 'Person',
        jobTitle: 'Preservation Spanish Water Dog Breeder & Service Dog Trainer',
        description:
          'Youngest Spanish Water Dog breeder in America by 30 years (one of only 5 breeders nationwide), mentored by breed pioneer and lifelong board member Lisa Harper. Former national breed club board member who modernized the club’s website for the 21st century.',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Upper East Side',
        addressLocality: 'New York',
        addressRegion: 'NY',
        addressCountry: 'US',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 40.7736,
        longitude: -73.9566,
      },
      areaServed: [
        { '@type': 'City', name: 'New York City' },
        { '@type': 'AdministrativeArea', name: 'New York' },
        { '@type': 'Country', name: 'United States' },
      ],
      knowsAbout: [
        'Spanish Water Dog',
        'Perro de Agua Español',
        'Task-Trained Mobility & Neurological Service Dogs',
        'Spinal Cord Injury Service Animals',
        'Neuromuscular Disorder Assistance Dogs (Cerebral Palsy, Multiple Sclerosis)',
        'Facility & Hospital Therapy Dogs',
        'Canine Stud Services',
        'OFA CHIC Health Tested Dog Breeding',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Qbits Spanish Water Dog Service Animal, Breeding & Stud Services',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Task-Trained Service Animal Prospects (Spinal Cord Injury & Neuromuscular Disorders)',
              url: KENNEL_INFO.gothamPawUrl,
              description:
                'At least one puppy from every Qbits Spanish Water Dog litter is transferred into our Service Animal Program in partnership with Gotham Paw, specializing in task-trained service dogs for spinal cord injuries, Cerebral Palsy, Multiple Sclerosis, and neurological conditions.',
              provider: { '@id': `${KENNEL_INFO.siteUrl}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Spanish Water Dog Stud Services — Dudley',
              description:
                'Approved stud services with our health-tested, service-proven Spanish Water Dog sire Dudley (natural cover in NYC, fresh-chilled overnight shipping, or frozen semen).',
              provider: { '@id': `${KENNEL_INFO.siteUrl}/#organization` },
            },
          },
          {
            '@type': 'Offer',
            availability: 'https://schema.org/PreOrder',
            itemOffered: {
              '@type': 'Product',
              name: 'Planned Spanish Water Dog Litters (Dudley × Molly — Fall 2027 & Spring 2028)',
              description:
                'Home-raised, health-tested Spanish Water Dog puppies from sire Dudley and dam Molly on the Upper East Side of New York City, planned for Fall 2027 and Spring 2028 for service, therapy, and devoted family companion homes.',
              brand: {
                '@type': 'Brand',
                name: KENNEL_INFO.name,
              },
            },
          },
        ],
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${KENNEL_INFO.siteUrl}/#faq`,
      mainEntity: FAQS.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer.replace(/<[^>]*>/g, ''),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- MANDATORY per respect-os-text-scale: opt in to OS-level text scaling -->
    <meta name="text-scale" content="scale" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO & Geo Meta Tags for Upper East Side, New York City -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={KENNEL_INFO.name} />
    <meta name="keywords" content="Spanish Water Dog breeders in America, Spanish Water Dog breeder NYC, Lisa Harper Spanish Water Dog mentor, Spanish Water Dog service dog, spinal cord injury service dog, Multiple Sclerosis service dog, Cerebral Palsy service dog, Gotham Paw service animal, Therapy dog Spanish Water Dog, Perro de Agua Español breeder, Qbits Spanish Water Dog Kennel, Spanish Water Dog stud service, Dudley Spanish Water Dog, Molly Spanish Water Dog, Fall 2027 Spring 2028 puppies" />
    <meta name="geo.region" content="US-NY" />
    <meta name="geo.placename" content="Upper East Side, New York City" />
    <meta name="geo.position" content="40.7736;-73.9566" />
    <meta name="ICBM" content="40.7736, -73.9566" />

    <!-- OpenGraph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={KENNEL_INFO.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />
    <meta property="og:image:alt" content={KENNEL_INFO.heroImage.alt} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${KENNEL_INFO.siteUrl}${KENNEL_INFO.heroImage.src}`} />

    <!-- AI / LLM / Autonomous Agent Discovery Links (llmstxt.org + Agent Context JSON) -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Qbits Kennel LLM Summary" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Qbits Kennel Full LLM Knowledge Base" />
    <link rel="alternate" type="application/json" href="/api/agent-context.json" title="Qbits Kennel Autonomous AI Agent Context" />
    <link rel="alternate" type="application/json" href="/.well-known/ai-agent.json" title="AI Agent Discovery Manifest" />

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#142B22" />

    <!-- Fast Google Fonts with preconnect and display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Restore Senior Accessibility Reading Preferences + GDPR Consent Mode v2 before first paint -->
    <script
      is:inline
      define:vars={{
        gaId: KENNEL_INFO.analytics.gaMeasurementId,
        piwikUrl: KENNEL_INFO.analytics.piwikUrl,
        piwikSiteId: KENNEL_INFO.analytics.piwikSiteId,
        clarityId: KENNEL_INFO.analytics.clarityProjectId,
      }}
    >
      try {
        const savedSize = localStorage.getItem('qbits-text-size');
        const savedContrast = localStorage.getItem('qbits-contrast');
        if (savedSize === 'large' || savedSize === 'xlarge') {
          document.documentElement.setAttribute('data-text-size', savedSize);
        }
        if (savedContrast === 'high') {
          document.documentElement.setAttribute('data-contrast', 'high');
        }
      } catch {}

      // Google Consent Mode v2 + Piwik PRO + Microsoft Clarity Privacy-First Initialization
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;

      // Default to denied per GDPR / Google Consent Mode v2 until user grants consent
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      // Piwik PRO / Matomo queue initialization (cookieless privacy mode until consent granted)
      window._paq = window._paq || [];
      window._paq.push(['requireConsent']);
      window._paq.push(['trackPageView']);
      window._paq.push(['enableLinkTracking']);

      window.qbitsAnalyticsConfig = { gaId, piwikUrl, piwikSiteId, clarityId };

      // Helper to fire unified events across GA4, Piwik PRO, and dataLayer
      window.qbitsTrackEvent = function (eventName, params) {
        const payload = Object.assign({ event: eventName, timestamp: new Date().toISOString() }, params || {});
        window.dataLayer.push(payload);
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, params || {});
        }
        if (Array.isArray(window._paq)) {
          window._paq.push([
            'trackEvent',
            params && params.category ? params.category : 'Kennel Funnel',
            eventName,
            params && params.label ? params.label : window.location.pathname,
          ]);
        }
      };
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />

    <!-- ==================================================================
         GDPR / CCPA PRIVACY & ANALYTICS CONSENT BANNER (Senior Accessible)
         ================================================================== -->
    <div
      id="gdpr-banner"
      class="gdpr-banner"
      role="region"
      aria-label="Privacy and Cookie Consent Banner"
      hidden
    >
      <div class="gdpr-banner-inner">
        <div class="gdpr-banner-copy">
          <strong>Your Privacy &amp; GDPR Choices at Qbits Kennel</strong>
          <p>
            We use privacy-respecting analytics (Google Analytics 4 with Consent Mode v2, Piwik PRO, and UX heatmaps) to understand how visitors and seniors use our website and improve our accessibility. We never sell your data. Read our <a href="/privacy">GDPR &amp; Privacy Policy</a>.
          </p>
        </div>
        <div class="gdpr-banner-actions">
          <button type="button" id="gdpr-accept-all" class="btn btn-primary btn-sm">
            ✓ Accept Analytics
          </button>
          <button type="button" id="gdpr-reject-optional" class="btn btn-outline btn-sm">
            Essential Only
          </button>
          <button
            type="button"
            commandfor="gdpr-consent-dialog"
            command="show-modal"
            class="btn btn-outline btn-sm"
          >
            ⚙ Customize GDPR Settings
          </button>
        </div>
      </div>
    </div>

    <!-- ==================================================================
         DECLARATIVE GDPR COOKIE & ANALYTICS PREFERENCES DIALOG
         ================================================================== -->
    <dialog id="gdpr-consent-dialog" class="app-modal" aria-labelledby="gdpr-modal-title">
      <div class="modal-header">
        <div>
          <span style="font-family: var(--font-mono); font-size: 0.78rem; color: #F3B398; text-transform: uppercase; letter-spacing: 0.1em;">
            GDPR, UK GDPR &amp; CCPA Compliance
          </span>
          <h2 id="gdpr-modal-title">Privacy, Cookie &amp; Analytics Preferences</h2>
        </div>
        <button
          type="button"
          commandfor="gdpr-consent-dialog"
          command="close"
          class="btn btn-outline-light btn-sm"
          aria-label="Close privacy preferences dialog"
        >
          ✕ Close
        </button>
      </div>
      <div class="modal-body">
        <p style="margin-top: 0; color: var(--text-slate);">
          Under the General Data Protection Regulation (GDPR) and state privacy laws, you have full control over how your visit is measured. You can change or withdraw your consent at any time.
        </p>

        <form id="gdpr-preferences-form">
          <div class="gdpr-option-row">
            <div>
              <label for="gdpr-essential" style="font-weight: 700; font-size: 1.05rem; display: block;">
                1. Strictly Necessary &amp; Accessibility Preferences (Always Active)
              </label>
              <span style="font-size: 0.92rem; color: var(--text-slate);">
                Stores your on-page Reading Comfort settings (Larger Text <code>A+</code>/<code>A++</code>, High Contrast mode) and your GDPR consent choice in local browser storage. No personal data is shared.
              </span>
            </div>
            <input type="checkbox" id="gdpr-essential" checked disabled aria-label="Strictly necessary cookies always active" />
          </div>

          <div class="gdpr-option-row">
            <div>
              <label for="gdpr-analytics" style="font-weight: 700; font-size: 1.05rem; display: block; cursor: pointer;">
                2. Google Analytics 4 &amp; Piwik PRO Performance Analytics
              </label>
              <span style="font-size: 0.92rem; color: var(--text-slate);">
                Helps us measure which pages, service dog guides, and puppy application funnels are most helpful to visitors (IP-anonymized).
              </span>
            </div>
            <input type="checkbox" id="gdpr-analytics" name="analytics" checked />
          </div>

          <div class="gdpr-option-row">
            <div>
              <label for="gdpr-ux" style="font-weight: 700; font-size: 1.05rem; display: block; cursor: pointer;">
                3. Accessibility &amp; Senior UX Diagnostics (Clarity Heatmaps)
              </label>
              <span style="font-size: 0.92rem; color: var(--text-slate);">
                Helps us see if buttons, navigation, or forms are difficult for senior citizens or assistive-device users to navigate (all form inputs are strictly masked).
              </span>
            </div>
            <input type="checkbox" id="gdpr-ux" name="ux" checked />
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-top: 1.5rem;">
            <div style="display: flex; flex-wrap: wrap; gap: 0.65rem;">
              <button type="submit" class="btn btn-primary btn-sm">
                Save My Preferences
              </button>
              <button type="button" id="gdpr-modal-accept-all" class="btn btn-terracotta btn-sm">
                Accept All
              </button>
            </div>
            <button type="button" id="gdpr-modal-reject-all" class="btn btn-outline btn-sm">
              Reject All Non-Essential
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <script>
      // GDPR Consent Manager + Dynamic Loader for GA4, Piwik PRO & Clarity + Custom Funnel Event Tracking
      const CONSENT_KEY = 'qbits-gdpr-consent-v1';
      const banner = document.getElementById('gdpr-banner');
      const dialog = document.getElementById('gdpr-consent-dialog') as HTMLDialogElement | null;
      const analyticsCheckbox = document.getElementById('gdpr-analytics') as HTMLInputElement | null;
      const uxCheckbox = document.getElementById('gdpr-ux') as HTMLInputElement | null;

      let scriptsLoaded = { ga: false, piwik: false, clarity: false };

      function applyConsent(prefs: { analytics: boolean; ux: boolean }) {
        const w = window as any;
        const cfg = w.qbitsAnalyticsConfig || {};

        if (typeof w.gtag === 'function') {
          w.gtag('consent', 'update', {
            analytics_storage: prefs.analytics ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
        }

        if (prefs.analytics) {
          if (Array.isArray(w._paq)) {
            w._paq.push(['setConsentGiven']);
          }
          // Load GA4 script once if configured
          if (!scriptsLoaded.ga && cfg.gaId && cfg.gaId !== 'G-QBITSSWDNY') {
            scriptsLoaded.ga = true;
            const s = document.createElement('script');
            s.async = true;
            s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(cfg.gaId)}`;
            document.head.appendChild(s);
            w.gtag('js', new Date());
            w.gtag('config', cfg.gaId, { anonymize_ip: true });
          }
        } else {
          if (Array.isArray(w._paq)) {
            w._paq.push(['forgetConsentGiven']);
          }
        }

        if (prefs.ux && !scriptsLoaded.clarity && cfg.clarityId && cfg.clarityId !== 'qbitsswdclarity') {
          scriptsLoaded.clarity = true;
          (function (c: any, l: Document, a: string, r: string, i: string) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            const t = l.createElement(r) as HTMLScriptElement;
            t.async = true;
            t.src = 'https://www.clarity.ms/tag/' + i;
            const y = l.getElementsByTagName(r)[0];
            y?.parentNode?.insertBefore(t, y);
          })(window, document, 'clarity', 'script', cfg.clarityId);
        }
      }

      function saveConsent(prefs: { analytics: boolean; ux: boolean }) {
        const record = {
          analytics: prefs.analytics,
          ux: prefs.ux,
          updatedAt: new Date().toISOString(),
        };
        try {
          localStorage.setItem(CONSENT_KEY, JSON.stringify(record));
        } catch {}
        if (banner) banner.hidden = true;
        if (dialog && dialog.open) dialog.close();
        if (analyticsCheckbox) analyticsCheckbox.checked = prefs.analytics;
        if (uxCheckbox) uxCheckbox.checked = prefs.ux;
        applyConsent(prefs);
      }

      // Check existing consent on load
      try {
        const raw = localStorage.getItem(CONSENT_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (analyticsCheckbox) analyticsCheckbox.checked = Boolean(parsed.analytics);
          if (uxCheckbox) uxCheckbox.checked = Boolean(parsed.ux);
          applyConsent({ analytics: Boolean(parsed.analytics), ux: Boolean(parsed.ux) });
        } else if (banner) {
          banner.hidden = false;
        }
      } catch {
        if (banner) banner.hidden = false;
      }

      document.getElementById('gdpr-accept-all')?.addEventListener('click', () => {
        saveConsent({ analytics: true, ux: true });
      });

      document.getElementById('gdpr-reject-optional')?.addEventListener('click', () => {
        saveConsent({ analytics: false, ux: false });
      });

      document.getElementById('gdpr-modal-accept-all')?.addEventListener('click', () => {
        saveConsent({ analytics: true, ux: true });
      });

      document.getElementById('gdpr-modal-reject-all')?.addEventListener('click', () => {
        saveConsent({ analytics: false, ux: false });
      });

      document.getElementById('gdpr-preferences-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        saveConsent({
          analytics: Boolean(analyticsCheckbox?.checked),
          ux: Boolean(uxCheckbox?.checked),
        });
      });

      // Track key funnel micro-conversions automatically
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const link = target?.closest('a') as HTMLAnchorElement | null;
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const track = (window as any).qbitsTrackEvent;
        if (typeof track !== 'function') return;

        if (href.includes('qbits-puppy-application.pdf')) {
          track('download_fillable_pdf', { category: 'Application Funnel', label: href });
        } else if (href.includes('qbits-clinical-service-dog-brochure.pdf')) {
          track('download_clinical_brochure_pdf', { category: 'Service Dog Funnel', label: href });
        } else if (href.includes('gothampaw.netlify.app')) {
          track('outbound_gotham_paw_click', { category: 'Service Dog Funnel', label: href });
        } else if (href.startsWith('mailto:')) {
          track('direct_email_click', { category: 'Contact Funnel', label: href });
        }
      });
    </script>
  </body>
</html>
